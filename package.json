{
  "name": "@avtopult/one-c-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/build-release.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "test:extension": "node --test one-c-extension-source/source-contract.test.mjs one-c-extension-source/base-metadata-contract.test.mjs one-c-extension-source/extension-project-contract.test.mjs",
    "test:docker-emulation": "bash scripts/run-docker-emulation.sh",
    "lint": "eslint src",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run test:extension && npm run lint && npm run format:check && npm run build && npm run bundle"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.10.0",
    "typescript-eslint": "8.70.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "prettier": "3.9.6",
    "esbuild": "0.28.2"
  }
}
