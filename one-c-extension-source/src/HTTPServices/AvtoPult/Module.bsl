Функция ПараметрURL(Запрос, Имя)
	Значение = Запрос.ПараметрыURL.Получить(Имя);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);
КонецФункции

