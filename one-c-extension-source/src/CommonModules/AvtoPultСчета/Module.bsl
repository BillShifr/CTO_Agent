// FR-INT-008: draft invoice preparation and atomic PDF outbox delivery.
// Native configuration printing is not inferred from OData metadata.

Функция Создать(Payload) Экспорт
	Контекст = ПроверитьЗапрос(Payload);
	Если Контекст.Свойство("Успех") Тогда
		Возврат Контекст;
	КонецЕсли;
	Набор = ПрочитатьПопытку(Контекст.Заказ, Контекст.Попытка);
	Если Набор.Количество() > 0 Тогда
		Запись = Набор[0];
		Если Запись.СуммаТиын <> Контекст.СуммаТиын Тогда
			Возврат AvtoPultКонтракт.Ошибка("INVOICE_ATTEMPT_CONFLICT", "Сумма попытки выставления счета отличается", 409);
		КонецЕсли;
		Если Запись.Состояние = "ready" Тогда
			Возврат Новый Структура("Успех,Данные", Истина,
				Новый Структура("contractVersion,requestId,status", "1.0", Запись.ИдентификаторЗапроса, "replayed"));
		КонецЕсли;
	КонецЕсли;
	// Never acknowledge an asynchronous request without a working print producer.
	Возврат Новый Структура("Успех,КодHTTP,Код,Сообщение,Повторяемая", Ложь, 503,
		"PRINT_PIPELINE_NOT_CONFIGURED", "Не подключен проверенный обработчик печати счета", Истина);
КонецФункции

Функция Подготовить(Payload) Экспорт
	// Internal entry point for the verified native print path, not an HTTP endpoint.
	Контекст = ПроверитьЗапрос(Payload);
	Если Контекст.Свойство("Успех") Тогда
		Возврат Контекст;
	КонецЕсли;
	Набор = ПрочитатьПопытку(Контекст.Заказ, Контекст.Попытка);
	Если Набор.Количество() > 0 Тогда
		Если Набор[0].СуммаТиын <> Контекст.СуммаТиын Тогда
			Возврат AvtoPultКонтракт.Ошибка("INVOICE_ATTEMPT_CONFLICT", "Сумма попытки выставления счета отличается", 409);
		КонецЕсли;
		Возврат Новый Структура("Успех,Счет", Истина, Набор[0].Счет);
	КонецЕсли;
	Заказ = Контекст.Заказ.ПолучитьОбъект();
	Если Не ЗначениеЗаполнено(Заказ.Организация) Или Не ЗначениеЗаполнено(Заказ.Контрагент)
		Или Не ЗначениеЗаполнено(Заказ.Партнер) Или Не ЗначениеЗаполнено(Заказ.Валюта) Тогда
		Возврат AvtoPultКонтракт.Ошибка("INVOICE_PREREQUISITES_MISSING", "В заказе не заполнены реквизиты счета");
	КонецЕсли;
	Счет = Документы.СчетНаОплатуКлиенту.СоздатьДокумент();
	Счет.Заполнить(Контекст.Заказ);
	Счет.Дата = ТекущаяДатаСеанса();
	Счет.ДокументОснование = Контекст.Заказ;
	Счет.Организация = Заказ.Организация;
	Счет.Партнер = Заказ.Партнер;
	Счет.Контрагент = Заказ.Контрагент;
	Счет.Валюта = Заказ.Валюта;
	Счет.СуммаДокумента = Контекст.СуммаТиын / 100;
	Если Не Счет.ПроверитьЗаполнение() Тогда
		Возврат AvtoPultКонтракт.Ошибка("INVOICE_FILLING_FAILED", "Не заполнены обязательные реквизиты счета");
	КонецЕсли;
	Счет.Записать(РежимЗаписиДокумента.Запись);
	Счет = Счет.Ссылка.ПолучитьОбъект();
	Если Счет.СуммаДокумента * 100 <> Контекст.СуммаТиын
		Или Счет.ДокументОснование <> Контекст.Заказ Или Счет.Проведен
		Или Счет.ПометкаУдаления Или Счет.Аннулирован
		Или Счет.Организация <> Заказ.Организация Или Счет.Валюта <> Заказ.Валюта
		Или Счет.Контрагент <> Заказ.Контрагент Или Счет.Партнер <> Заказ.Партнер Тогда
		// Throw: the internal caller must roll back all native handler effects.
		ВызватьИсключение "Сохраненные реквизиты счета изменены обработчиками 1С";
	КонецЕсли;
	Запись = Набор.Добавить();
	Запись.Заказ = Контекст.Заказ;
	Запись.Попытка = Контекст.Попытка;
	Запись.Счет = Счет.Ссылка;
	Запись.СуммаТиын = Контекст.СуммаТиын;
	Запись.ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор());
	Запись.EventId = Строка(Новый УникальныйИдентификатор());
	Запись.Состояние = "awaiting-print";
	Набор.Записать();
	Контекст.Связь[0].СчетВыставлен = Истина;
	Контекст.Связь.Записать();
	Возврат Новый Структура("Успех,Счет", Истина, Счет.Ссылка);
КонецФункции

Процедура ПринятьPDF(Счет, Попытка, ТабличныйДокумент) Экспорт
	ПроверитьТранзакцию();
	Если ТипЗнч(Счет) <> Тип("ДокументСсылка.СчетНаОплатуКлиенту")
		Или ТипЗнч(ТабличныйДокумент) <> Тип("ТабличныйДокумент") Тогда
		ВызватьИсключение "Некорректные типы счета и печатной формы";
	КонецЕсли;
	ЗаблокироватьЗаказы();
	ЗаблокироватьДокумент("Документ.СчетНаОплатуКлиенту", Счет);
	Документ = Счет.ПолучитьОбъект();
	Если Документ = Неопределено Или Документ.ПометкаУдаления Или Документ.Аннулирован Тогда
		ВызватьИсключение "Счет недоступен для выдачи";
	КонецЕсли;
	Набор = ПрочитатьПопытку(Документ.ДокументОснование, Попытка);
	Если Набор.Количество() <> 1 Или Набор[0].Счет <> Счет Тогда
		ВызватьИсключение "Счет не соответствует запросу AvtoPult";
	КонецЕсли;
	Запись = Набор[0];
	Если Запись.СуммаТиын <> Документ.СуммаДокумента * 100 Тогда
		ВызватьИсключение "Сумма счета изменена после запроса";
	КонецЕсли;
	// A replay never regenerates PDF bytes: exports may contain variable metadata.
	Если Запись.Состояние = "ready" Тогда
		Возврат;
	КонецЕсли;
	ДанныеPDF = ВыгрузитьPDF(ТабличныйДокумент);
	Если ДанныеPDF.Размер() = 0 Или ДанныеPDF.Размер() > 10485760 Тогда
		ВызватьИсключение "Недопустимый размер PDF";
	КонецЕсли;
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ДанныеPDF);
	SHA256 = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	Данные = Новый Структура;
	Данные.Вставить("eventId", Запись.EventId);
	Данные.Вставить("workOrderExternalId", Строка(Запись.Заказ.УникальныйИдентификатор()));
	Данные.Вставить("requestAttempt", Попытка);
	Данные.Вставить("invoiceExternalId", Строка(Счет.УникальныйИдентификатор()));
	Данные.Вставить("invoiceNumber", Документ.Номер);
	Данные.Вставить("issuedAt", Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z");
	Данные.Вставить("amountTiyn", Формат(Запись.СуммаТиын, "ЧГ=0;ЧДЦ=0"));
	Данные.Вставить("documentSha256", SHA256);
	AvtoPultИнтеграция.ПоставитьPDFСчетаВОчердь(Запись.EventId, Данные, ДанныеPDF);
	Запись.SHA256 = SHA256;
	Запись.Состояние = "ready";
	Набор.Записать();
КонецПроцедуры

Функция ПроверитьЗапрос(Payload)
	ПроверитьТранзакцию();
	Если AvtoPultКонтракт.Свойство(Payload, "contractVersion") <> "1.0" Тогда
		Возврат AvtoPultКонтракт.Ошибка("CONTRACT_VERSION_UNSUPPORTED", "Неподдерживаемая версия контракта", 400);
	КонецЕсли;
	ПопыткаЗапроса = AvtoPultКонтракт.Свойство(Payload, "requestAttempt");
	Если ТипЗнч(ПопыткаЗапроса) <> Тип("Число") Тогда
		Возврат AvtoPultКонтракт.Ошибка("INVALID_ATTEMPT", "Некорректная попытка", 400);
	КонецЕсли;
	Если ПопыткаЗапроса < 1 Или ПопыткаЗапроса > 2147483647 Или Цел(ПопыткаЗапроса) <> ПопыткаЗапроса Тогда
		Возврат AvtoPultКонтракт.Ошибка("INVALID_ATTEMPT", "Некорректная попытка", 400);
	КонецЕсли;
	Если Не AvtoPultКонтракт.ДеньгиДопустимы(AvtoPultКонтракт.Свойство(Payload, "amountTiyn")) Тогда
		Возврат AvtoPultКонтракт.Ошибка("INVALID_AMOUNT", "Некорректная сумма счета", 400);
	КонецЕсли;
	Сумма = AvtoPultКонтракт.Тиыны(AvtoPultКонтракт.Свойство(Payload, "amountTiyn"));
	Если Не AvtoPultКонтракт.GUIDДопустим(AvtoPultКонтракт.Свойство(Payload, "workOrderExternalId")) Тогда
		Возврат AvtoPultКонтракт.Ошибка("INVALID_ORDER_ID", "Некорректный идентификатор заказа", 400);
	КонецЕсли;
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(AvtoPultКонтракт.Свойство(Payload, "workOrderExternalId"));
	Исключение
		Возврат AvtoPultКонтракт.Ошибка("INVALID_ORDER_ID", "Некорректный идентификатор заказа", 400);
	КонецПопытки;
	ЗаблокироватьЗаказы();
	Заказ = Документы.ЗаказКлиента.ПолучитьСсылку(Идентификатор);
	Запрос = Новый Запрос("ВЫБРАТЬ WorkOrderId ИЗ РегистрСведений.AvtoPultЗаказы ГДЕ ЗаказКлиента = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Связи = Запрос.Выполнить().Выгрузить();
	Если Связи.Количество() <> 1 Тогда
		Возврат AvtoPultКонтракт.Ошибка("ORDER_MAPPING_MISSING", "Заказ не связан с AvtoPult", 409);
	КонецЕсли;
	Связь = РегистрыСведений.AvtoPultЗаказы.СоздатьНаборЗаписей();
	Связь.Отбор.WorkOrderId.Установить(Связи[0].WorkOrderId);
	Связь.Прочитать();
	ЗаблокироватьДокумент("Документ.ЗаказКлиента", Заказ);
	Объект = Заказ.ПолучитьОбъект();
	Если Объект = Неопределено Или Объект.ПометкаУдаления Тогда
		Возврат AvtoPultКонтракт.Ошибка("ORDER_NOT_FOUND", "Заказ не найден", 404);
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ВерсияДанных ИЗ Документ.ЗаказКлиента ГДЕ Ссылка = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Версии = Запрос.Выполнить().Выгрузить();
	Если Версии.Количество() <> 1 Или Base64Строка(Версии[0].ВерсияДанных) <> Связь[0].Версия1С Тогда
		Возврат AvtoPultКонтракт.Ошибка("NATIVE_VERSION_CONFLICT", "Заказ изменен в 1С; требуется сверка", 409);
	КонецЕсли;
	Если Сумма <= 0 Или Объект.СуммаДокумента * 100 <> Сумма Тогда
		Возврат AvtoPultКонтракт.Ошибка("INVOICE_AMOUNT_MISMATCH", "Сумма счета не совпадает с заказом", 409);
	КонецЕсли;
	Возврат Новый Структура("Заказ,Попытка,СуммаТиын,Связь", Заказ, ПопыткаЗапроса, Сумма, Связь);
КонецФункции

Процедура ЗаблокироватьДокумент(Область, Ссылка)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Область);
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьТранзакцию()
	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Операция счета требует общей транзакции";
	КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьЗаказы()
	// Same lock domain as order mutations, before the invoice-attempt lock.
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.AvtoPultЗаказы");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ПрочитатьПопытку(Заказ, Попытка)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.AvtoPultЗапросыСчетов");
	Элемент.УстановитьЗначение("Заказ", Заказ);
	Элемент.УстановитьЗначение("Попытка", Попытка);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Набор = РегистрыСведений.AvtoPultЗапросыСчетов.СоздатьНаборЗаписей();
	Набор.Отбор.Заказ.Установить(Заказ);
	Набор.Отбор.Попытка.Установить(Попытка);
	Набор.Прочитать();
	Возврат Набор;
КонецФункции

Функция ВыгрузитьPDF(ТабличныйДокумент)
	ИмяФайла = ПолучитьИмяВременногоФайла("pdf");
	Попытка
		ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.PDF);
		Данные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(ИмяФайла);
	Возврат Данные;
КонецФункции
