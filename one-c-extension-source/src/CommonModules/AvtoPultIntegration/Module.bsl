#Область ПубличныйИнтерфейс

Функция ОбработатьИзменение(Запрос, Операция, ИмяОбработчика) Экспорт
	ОшибкаВерсии = ОшибкаВерсииКонтракта(Запрос);
	Если ОшибкаВерсии <> Неопределено Тогда
		Возврат ОшибкаВерсии;
	КонецЕсли;
	Ключ = НормализоватьСтроку(Запрос.Заголовки.Получить("Idempotency-Key"));
	Если Не КлючИдемпотентностиДопустим(Ключ) Тогда
		Возврат ОтветОшибки(400, "IDEMPOTENCY_KEY_REQUIRED", "Не задан ключ идемпотентности", Ложь);
	КонецЕсли;
	Тело = Запрос.ПолучитьТелоКакСтроку();
	Попытка
		Payload = ПрочитатьТелоJSON(Тело);
	Исключение
		Возврат ОтветОшибки(400, "REQUEST_BODY_INVALID", "Требуется корректное тело JSON", Ложь);
	КонецПопытки;
	Попытка
		Хеш = SHA256(Тело);
	Исключение
		Возврат ОтветОшибки(500, "ONE_C_APPLICATION_ERROR", "Операция 1С завершилась ошибкой", Истина);
	КонецПопытки;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРезультат(Ключ);
		Повтор = НайтиРезультат(Ключ);
		Если Повтор <> Неопределено Тогда
			Если Повтор.Операция <> Операция Или Повтор.ХешЗапроса <> Хеш Тогда
				ОтменитьТранзакцию();
				Возврат ОтветОшибки(409, "IDEMPOTENCY_CONFLICT", "Ключ уже использован с другим телом", Ложь);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
			Возврат СохраненныйОтвет(Повтор);
		КонецЕсли;

		// Обработчики размещены в серверном общем модуле адаптера нетиповой конфигурации.
		Если ИмяОбработчика = "ПрименитьЗаказКлиента" Тогда
			ОтветАдаптера = AvtoPultАдаптерКА2.ПрименитьЗаказКлиента(Payload);
		ИначеЕсли ИмяОбработчика = "СоздатьИлиНайтиСчет" Тогда
			ОтветАдаптера = AvtoPultАдаптерКА2.СоздатьИлиНайтиСчет(Payload);
		ИначеЕсли ИмяОбработчика = "ПрименитьНачисления" Тогда
			ОтветАдаптера = AvtoPultАдаптерКА2.ПрименитьНачисления(Payload);
		Иначе
			ВызватьИсключение "Неизвестный обработчик AvtoPult";
		КонецЕсли;
		КодУспеха = ?(Операция = "invoices", 202, 200);
		ПодготовленныйОтвет = ПодготовитьОтветАдаптера(ОтветАдаптера, КодУспеха);
		Если Не ОтветАдаптера.Успех Тогда
			// A controlled error must never commit partial business effects.
			ОтменитьТранзакцию();
			Если ОтветАдаптера.Повторяемая Тогда
				Возврат JSONОтвет(ПодготовленныйОтвет.КодHTTP, ПодготовленныйОтвет.Тело);
			КонецЕсли;
			Возврат СохранитьТерминальнуюОшибку(Ключ, Операция, Хеш, ПодготовленныйОтвет);
		КонецЕсли;
		СохранитьРезультат(
			Ключ,
			Операция,
			Хеш,
			ПодготовленныйОтвет.КодHTTP,
			ПодготовленныйОтвет.Тело);
		ЗафиксироватьТранзакцию();
		Возврат JSONОтвет(ПодготовленныйОтвет.КодHTTP, ПодготовленныйОтвет.Тело);
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат ОтветОшибки(500, "ONE_C_APPLICATION_ERROR", "Операция 1С завершилась ошибкой", Истина);
	КонецПопытки;
КонецФункции

Функция ПолучитьИсходящиеСобытия(Запрос) Экспорт
	ОшибкаВерсии = ОшибкаВерсииКонтракта(Запрос);
	Если ОшибкаВерсии <> Неопределено Тогда
		Возврат ОшибкаВерсии;
	КонецЕсли;
	РезультатПодготовки = ПодготовитьОбратныеИзменения();
	Если РезультатПодготовки <> Неопределено Тогда Возврат РезультатПодготовки; КонецЕсли;
	Возврат ПолучитьИсходящиеОбъекты("event", 50, "events");
КонецФункции

Функция ПолучитьИсходящиеДокументы(Запрос) Экспорт
	ОшибкаВерсии = ОшибкаВерсииКонтракта(Запрос);
	Если ОшибкаВерсии <> Неопределено Тогда
		Возврат ОшибкаВерсии;
	КонецЕсли;
	Возврат ПолучитьИсходящиеОбъекты("invoice-document", 10, "documents");
КонецФункции

Процедура ПоставитьСобытиеВОчердь(EventId, Событие) Экспорт
	СохранитьНовыйИсходящийОбъект(EventId, "event", Событие, Неопределено);
КонецПроцедуры

Процедура ПоставитьPDFСчетаВОчердь(EventId, ДанныеЗагрузки, СодержимоеPDF) Экспорт
	Если ТипЗнч(СодержимоеPDF) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "PDF должен быть передан как ДвоичныеДанные";
	КонецЕсли;
	СохранитьНовыйИсходящийОбъект(
		EventId,
		"invoice-document",
		ДанныеЗагрузки,
		Новый ХранилищеЗначения(СодержимоеPDF, Новый СжатиеДанных(9)));
КонецПроцедуры

Функция ПодтвердитьИсходящийОбъект(EventId, Запрос, Вид) Экспорт
	ОшибкаВерсии = ОшибкаВерсииКонтракта(Запрос);
	Если ОшибкаВерсии <> Неопределено Тогда
		Возврат ОшибкаВерсии;
	КонецЕсли;
	Если ПустаяСтрока(EventId) Тогда
		Возврат ОтветОшибки(400, "EVENT_ID_REQUIRED", "Не задан eventId", Ложь);
	КонецЕсли;
	Попытка
		Тело = ПрочитатьТелоJSON(Запрос.ПолучитьТелоКакСтроку());
		LeaseToken = СокрЛП(Тело.leaseToken);
	Исключение
		Возврат ОтветОшибки(400, "LEASE_TOKEN_REQUIRED", "Не задан lease token", Ложь);
	КонецПопытки;
	Если СтрДлина(LeaseToken) < 32 Тогда
		Возврат ОтветОшибки(400, "LEASE_TOKEN_REQUIRED", "Не задан lease token", Ложь);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьИсходящиеОбъекты();
		Запись = НайтиИсходящийОбъект(EventId, Вид);
		Если Запись = Неопределено Тогда
			ОтменитьТранзакцию();
			Возврат ОтветОшибки(404, "OUTBOX_ITEM_NOT_FOUND", "Исходящий объект не найден", Ложь);
		КонецЕсли;
		Если Запись.Состояние <> "leased"
			Или Запись.LeaseToken <> LeaseToken
			Или Запись.LeaseUntil < ТекущаяУниверсальнаяДата() Тогда
			ОтменитьТранзакцию();
			Возврат ОтветОшибки(409, "LEASE_CONFLICT", "Lease истёк или принадлежит другому процессу", Истина);
		КонецЕсли;
		ВерсияОблака = 0;
		Событие = ПрочитатьТелоJSON(Запись.PayloadJSON);
		Если Вид = "event" И AvtoPultКонтракт.Свойство(Событие, "event") = "workorder.changed" Тогда
			ВерсияОблака = AvtoPultКонтракт.Свойство(Тело, "workOrderVersion");
			Если Не AvtoPultКонтракт.ЦелоеВДиапазоне(ВерсияОблака, 1, 9007199254740991) Тогда
				ОтменитьТранзакцию();
				Возврат ОтветОшибки(400, "RESULT_VERSION_REQUIRED", "Не подтверждена версия результата", Ложь);
			КонецЕсли;
			Если ВерсияОблака <= Событие.baseVersion Тогда
				ОтменитьТранзакцию();
				Возврат ОтветОшибки(409, "RESULT_VERSION_INVALID", "Версия результата не продвинулась", Ложь);
			КонецЕсли;
		КонецЕсли;
		ЗаписатьСостояниеИсходящегоОбъекта(Запись, "delivered", "", Дата(1, 1, 1), ТекущаяУниверсальнаяДата(), Неопределено, ВерсияОблака);
		Если Вид = "event" И AvtoPultКонтракт.Свойство(Событие, "event") = "workorder.changed" Тогда
			AvtoPultИзмененияЗаказов.ПодтвердитьДоставку(EventId, ВерсияОблака);
		ИначеЕсли Вид = "event" И ЭтоСобытиеРасчета(AvtoPultКонтракт.Свойство(Событие, "event")) Тогда
			AvtoPultРасчеты.ПодтвердитьДоставку(EventId);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
		Возврат ПустойОтвет(204);
	Исключение
		ОтменитьТранзакцию();
		Возврат ОтветОшибки(500, "ONE_C_OUTBOX_ERROR", "Исходящая очередь 1С завершила операцию с ошибкой", Истина);
	КонецПопытки;
КонецФункции

Функция ПолучитьСодержимоеДокумента(EventId, Запрос) Экспорт
	ОшибкаВерсии = ОшибкаВерсииКонтракта(Запрос);
	Если ОшибкаВерсии <> Неопределено Тогда
		Возврат ОшибкаВерсии;
	КонецЕсли;
	LeaseToken = НормализоватьСтроку(Запрос.Заголовки.Получить("X-AvtoPult-Lease-Token"));
	Если ПустаяСтрока(EventId) Или СтрДлина(LeaseToken) < 32 Тогда
		Возврат ОтветОшибки(400, "LEASE_TOKEN_REQUIRED", "Не заданы eventId или lease token", Ложь);
	КонецЕсли;
	Запись = НайтиИсходящийОбъект(EventId, "invoice-document");
	Если Запись = Неопределено Тогда
		Возврат ОтветОшибки(404, "OUTBOX_ITEM_NOT_FOUND", "Документ не найден", Ложь);
	КонецЕсли;
	Если Запись.Состояние <> "leased"
		Или Запись.LeaseToken <> LeaseToken
		Или Запись.LeaseUntil < ТекущаяУниверсальнаяДата() Тогда
		Возврат ОтветОшибки(409, "LEASE_CONFLICT", "Lease истёк или принадлежит другому процессу", Истина);
	КонецЕсли;
	Если Запись.Содержимое = Неопределено Тогда
		Возврат ОтветОшибки(410, "DOCUMENT_CONTENT_MISSING", "PDF отсутствует в outbox", Ложь);
	КонецЕсли;
	Возврат ДвоичныйОтвет(200, Запись.Содержимое.Получить(), "application/pdf");
КонецФункции

Функция ОшибкаВерсииКонтракта(Запрос)
	Если НормализоватьСтроку(Запрос.Заголовки.Получить("X-AvtoPult-Contract-Version")) <> "1.0" Тогда
		Возврат ОтветОшибки(400, "CONTRACT_VERSION_UNSUPPORTED", "Требуется контракт 1.0", Ложь);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПодготовитьОтветАдаптера(ОтветАдаптера, КодУспеха)
	Если ТипЗнч(ОтветАдаптера) <> Тип("Структура") Тогда
		ВызватьИсключение "Адаптер вернул ответ неверного типа";
	КонецЕсли;
	Если Не ОтветАдаптера.Свойство("Успех", Успех) Или ТипЗнч(Успех) <> Тип("Булево") Тогда
		ВызватьИсключение "Адаптер не указал признак успеха";
	КонецЕсли;
	Если Успех Тогда
		Если Не ОтветАдаптера.Свойство("Данные", Данные) Тогда
			ВызватьИсключение "Адаптер не вернул данные результата";
		КонецЕсли;
		Возврат Новый Структура("КодHTTP,Тело", КодУспеха, СериализоватьJSON(Данные));
	КонецЕсли;

	Если Не ОтветАдаптера.Свойство("КодHTTP", КодHTTP)
		Или Не ОтветАдаптера.Свойство("Код", Код)
		Или Не ОтветАдаптера.Свойство("Сообщение", Сообщение)
		Или Не ОтветАдаптера.Свойство("Повторяемая", Повторяемая) Тогда
		ВызватьИсключение "Адаптер вернул неполную бизнес-ошибку";
	КонецЕсли;
	Если Не ОшибкаАдаптераДопустима(КодHTTP, Код, Сообщение, Повторяемая) Тогда
		ВызватьИсключение "Адаптер вернул недопустимую бизнес-ошибку";
	КонецЕсли;
	Проблема = Новый Структура(
		"contractVersion,code,message,retryable",
		"1.0",
		Код,
		Сообщение,
		Повторяемая);
	Если ОтветАдаптера.Свойство("ТекущаяВерсия", ТекущаяВерсия) Тогда
		Если ТипЗнч(ТекущаяВерсия) <> Тип("Число")
			Или ТекущаяВерсия < 0
			Или Цел(ТекущаяВерсия) <> ТекущаяВерсия Тогда
			ВызватьИсключение "Адаптер вернул недопустимую текущую версию";
		КонецЕсли;
		Проблема.Вставить("currentVersion", ТекущаяВерсия);
	КонецЕсли;
	Тело = СериализоватьJSON(Проблема);
	Возврат Новый Структура("КодHTTP,Тело", КодHTTP, Тело);
КонецФункции

Функция ОшибкаАдаптераДопустима(КодHTTP, Код, Сообщение, Повторяемая)
	Если ТипЗнч(КодHTTP) <> Тип("Число")
		Или ТипЗнч(Повторяемая) <> Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = НормализоватьСтроку(Код);
	Сообщение = НормализоватьСтроку(Сообщение);
	Если СтрДлина(Код) < 3 Или СтрДлина(Код) > 64
		Или СтрДлина(Сообщение) < 1 Или СтрДлина(Сообщение) > 500 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Повторяемая Тогда
		Возврат КодHTTP = 423 Или КодHTTP = 429 Или КодHTTP = 502 Или КодHTTP = 503 Или КодHTTP = 504;
	КонецЕсли;
	Возврат КодHTTP = 400 Или КодHTTP = 403 Или КодHTTP = 404 Или КодHTTP = 409 Или КодHTTP = 422;
КонецФункции

#КонецОбласти

#Область ИсходящаяОчередь

Функция ПодготовитьОбратныеИзменения()
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьИсходящиеОбъекты();
		AvtoPultРасчеты.ПоставитьОжидающиеВОчердь();
		AvtoPultИзмененияЗаказов.ПоставитьОжидающиеВОчердь();
		ЗафиксироватьТранзакцию();
		Возврат Неопределено;
	Исключение
		ОтменитьТранзакцию();
		Возврат ОтветОшибки(500, "ONE_C_REVERSE_PUMP_ERROR", "Не удалось подготовить обратные изменения", Истина);
	КонецПопытки;
КонецФункции

Функция ЭтоСобытиеРасчета(ИмяСобытия)
	Возврат ИмяСобытия = "cash.payment" Или ИмяСобытия = "cash.refund"
		Или ИмяСобытия = "invoice.payment" Или ИмяСобытия = "invoice.refund";
КонецФункции

Процедура СохранитьНовыйИсходящийОбъект(EventId, Вид, Payload, Содержимое)
	// The caller owns the business transaction; never commit a detached event.
	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "TRANSACTION_REQUIRED"; КонецЕсли;
	Если ТипЗнч(EventId) <> Тип("Строка") Тогда
		ВызватьИсключение "Некорректный eventId исходящего объекта";
	КонецЕсли;
	Если ПустаяСтрока(EventId) Или СтрДлина(EventId) > 128 Или СокрЛП(EventId) <> EventId Тогда
		ВызватьИсключение "Некорректный eventId исходящего объекта";
	КонецЕсли;
	Если ТипЗнч(Payload) <> Тип("Структура") Тогда
		ВызватьИсключение "OUTBOX_EVENT_ID_MISMATCH";
	КонецЕсли;
	Если Не Payload.Свойство("eventId", ИдентификаторТела) Или ИдентификаторТела <> EventId Тогда
		ВызватьИсключение "OUTBOX_EVENT_ID_MISMATCH";
	КонецЕсли;
	Если Вид <> "event" И Вид <> "invoice-document" Тогда
		ВызватьИсключение "Некорректный вид исходящего объекта";
	КонецЕсли;
	ЗаблокироватьИсходящиеОбъекты();
	Если НайтиИсходящийОбъект(EventId, Вид) <> Неопределено Тогда
		ВызватьИсключение "EventId уже существует в исходящей очереди";
	КонецЕсли;
	Набор = РегистрыСведений.AvtoPultИсходящиеСобытия.СоздатьНаборЗаписей();
	Набор.Отбор.EventId.Установить(EventId);
	Набор.Отбор.Вид.Установить(Вид);
	Запись = Набор.Добавить();
	Запись.EventId = EventId;
	Запись.Вид = Вид;
	Запись.КлючЗаказа = КлючЗаказаСобытия(Payload);
	Запись.Порядок = СледующийПорядокОчереди();
	Запись.PayloadJSON = СериализоватьJSON(Payload);
	Запись.Содержимое = Содержимое;
	Запись.Состояние = "new";
	Запись.LeaseToken = "";
	Запись.LeaseUntil = Дата(1, 1, 1);
	Запись.ЧислоПопыток = 0;
	Запись.СозданоВ = ТекущаяУниверсальнаяДата();
	Запись.ДоставленоВ = Дата(1, 1, 1);
	Набор.Записать();
КонецПроцедуры

Функция КлючЗаказаСобытия(Payload)
	Тело = Payload;
	Если AvtoPultКонтракт.Свойство(Payload, "event", "") = "invoice.issued" Тогда
		Тело = AvtoPultКонтракт.Свойство(Payload, "payload");
	КонецЕсли;
	Ключ = AvtoPultКонтракт.Свойство(Тело, "workOrderExternalId", "");
	Если ТипЗнч(Ключ) <> Тип("Строка") Тогда ВызватьИсключение "OUTBOX_ORDER_REQUIRED"; КонецЕсли;
	Если ПустаяСтрока(Ключ) Или СтрДлина(Ключ) > 128 Или СокрЛП(Ключ) <> Ключ Тогда
		ВызватьИсключение "OUTBOX_ORDER_REQUIRED";
	КонецЕсли;
	Возврат Ключ;
КонецФункции

// Called only under the same exclusive queue lock as insertion and claim.
Функция СледующийПорядокОчереди()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ЕСТЬNULL(МАКСИМУМ(Очередь.Порядок), 0) КАК Последний "
		+ "ИЗ РегистрСведений.AvtoPultИсходящиеСобытия КАК Очередь";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Если Выборка.Последний >= 999999999999999999 Тогда ВызватьИсключение "OUTBOX_SEQUENCE_EXHAUSTED"; КонецЕсли;
	Возврат Выборка.Последний + 1;
КонецФункции

// Input must be ordered by Порядок and include ALL non-delivered rows of this kind.
Функция ЭтоДоступнаяГолова(Запись, Заказы, Сейчас) Экспорт
	Если ПустаяСтрока(Запись.КлючЗаказа) Или Запись.Порядок <= 0 Тогда
		ВызватьИсключение "OUTBOX_ORDERING_MIGRATION_REQUIRED";
	КонецЕсли;
	Если Заказы.Получить(Запись.КлючЗаказа) <> Неопределено Тогда Возврат Ложь; КонецЕсли;
	Заказы.Вставить(Запись.КлючЗаказа, Истина);
	// A live lease or reconciliation state blocks successors, not independent orders.
	Возврат Запись.Состояние = "new"
		Или (Запись.Состояние = "leased" И Запись.LeaseUntil < Сейчас);
КонецФункции

Функция ПолучитьИсходящиеОбъекты(Вид, Лимит, ИмяКоллекции)
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьИсходящиеОбъекты();
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ" + Символы.ПС
			+ "| Очередь.EventId КАК EventId," + Символы.ПС
			+ "| Очередь.Вид КАК Вид," + Символы.ПС
			+ "| Очередь.КлючЗаказа КАК КлючЗаказа," + Символы.ПС
			+ "| Очередь.Порядок КАК Порядок," + Символы.ПС
			+ "| Очередь.LeaseUntil КАК LeaseUntil," + Символы.ПС
			+ "| Очередь.Состояние КАК Состояние" + Символы.ПС
			+ "|ИЗ РегистрСведений.AvtoPultИсходящиеСобытия КАК Очередь" + Символы.ПС
			+ "|ГДЕ Очередь.Вид = &Вид" + Символы.ПС
			+ "| И Очередь.Состояние <> &Доставлено" + Символы.ПС
			+ "|УПОРЯДОЧИТЬ ПО Очередь.Порядок";
		Запрос.УстановитьПараметр("Вид", Вид);
		Запрос.УстановитьПараметр("Доставлено", "delivered");
		Выборка = Запрос.Выполнить().Выбрать();
		Элементы = Новый Массив;
		Заказы = Новый Соответствие;
		Сейчас = ТекущаяУниверсальнаяДата();
		Пока Выборка.Следующий() Цикл
			Если Не ЭтоДоступнаяГолова(Выборка, Заказы, Сейчас) Тогда Продолжить; КонецЕсли;
			Запись = НайтиИсходящийОбъект(Выборка.EventId, Вид);
			Если Запись = Неопределено Тогда ВызватьИсключение "OUTBOX_HEAD_MISSING"; КонецЕсли;
			LeaseToken = Строка(Новый УникальныйИдентификатор());
			LeaseUntil = ТекущаяУниверсальнаяДата() + 120;
			ЗаписатьСостояниеИсходящегоОбъекта(
				Запись,
				"leased",
				LeaseToken,
				LeaseUntil,
				Дата(1, 1, 1),
				Запись.ЧислоПопыток + 1);
			Payload = ПрочитатьТелоJSON(Запись.PayloadJSON);
			Если Вид = "event" Тогда
				Элементы.Добавить(Новый Структура("leaseToken,event", LeaseToken, Payload));
			Иначе
				Элементы.Добавить(Новый Структура("leaseToken,upload", LeaseToken, Payload));
			КонецЕсли;
			Если Элементы.Количество() >= Лимит Тогда Прервать; КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
		Ответ = Новый Структура;
		Ответ.Вставить(ИмяКоллекции, Элементы);
		Возврат JSONОтвет(200, СериализоватьJSON(Ответ));
	Исключение
		ОтменитьТранзакцию();
		Возврат ОтветОшибки(500, "ONE_C_OUTBOX_ERROR", "Исходящая очередь 1С завершила операцию с ошибкой", Истина);
	КонецПопытки;
КонецФункции

Процедура ЗаблокироватьИсходящиеОбъекты()
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.AvtoPultИсходящиеСобытия");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция НайтиИсходящийОбъект(EventId, Вид)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1" + Символы.ПС
		+ "| Очередь.EventId КАК EventId," + Символы.ПС
		+ "| Очередь.Вид КАК Вид," + Символы.ПС
		+ "| Очередь.КлючЗаказа КАК КлючЗаказа," + Символы.ПС
		+ "| Очередь.Порядок КАК Порядок," + Символы.ПС
		+ "| Очередь.PayloadJSON КАК PayloadJSON," + Символы.ПС
		+ "| Очередь.РезультатВерсияЗаказа КАК РезультатВерсияЗаказа," + Символы.ПС
		+ "| Очередь.Содержимое КАК Содержимое," + Символы.ПС
		+ "| Очередь.Состояние КАК Состояние," + Символы.ПС
		+ "| Очередь.LeaseToken КАК LeaseToken," + Символы.ПС
		+ "| Очередь.LeaseUntil КАК LeaseUntil," + Символы.ПС
		+ "| Очередь.ЧислоПопыток КАК ЧислоПопыток," + Символы.ПС
		+ "| Очередь.СозданоВ КАК СозданоВ" + Символы.ПС
		+ "|ИЗ РегистрСведений.AvtoPultИсходящиеСобытия КАК Очередь" + Символы.ПС
		+ "|ГДЕ Очередь.EventId = &EventId И Очередь.Вид = &Вид";
	Запрос.УстановитьПараметр("EventId", EventId);
	Запрос.УстановитьПараметр("Вид", Вид);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Выборка;
КонецФункции

Процедура ЗаписатьСостояниеИсходящегоОбъекта(Запись, Состояние, LeaseToken, LeaseUntil, ДоставленоВ, ЧислоПопыток = Неопределено, ВерсияОблака = Неопределено)
	Набор = РегистрыСведений.AvtoPultИсходящиеСобытия.СоздатьНаборЗаписей();
	Набор.Отбор.EventId.Установить(Запись.EventId);
	Набор.Отбор.Вид.Установить(Запись.Вид);
	НоваяЗапись = Набор.Добавить();
	НоваяЗапись.EventId = Запись.EventId;
	НоваяЗапись.Вид = Запись.Вид;
	НоваяЗапись.КлючЗаказа = Запись.КлючЗаказа;
	НоваяЗапись.Порядок = Запись.Порядок;
	НоваяЗапись.PayloadJSON = Запись.PayloadJSON;
	НоваяЗапись.РезультатВерсияЗаказа = ?(ВерсияОблака = Неопределено, Запись.РезультатВерсияЗаказа, ВерсияОблака);
	НоваяЗапись.Содержимое = Запись.Содержимое;
	НоваяЗапись.Состояние = Состояние;
	НоваяЗапись.LeaseToken = LeaseToken;
	НоваяЗапись.LeaseUntil = LeaseUntil;
	НоваяЗапись.СозданоВ = Запись.СозданоВ;
	НоваяЗапись.ДоставленоВ = ДоставленоВ;
	Если ЧислоПопыток = Неопределено Тогда
		НоваяЗапись.ЧислоПопыток = Запись.ЧислоПопыток;
	Иначе
		НоваяЗапись.ЧислоПопыток = ЧислоПопыток;
	КонецЕсли;
	Набор.Записать();
КонецПроцедуры

#КонецОбласти

#Область Идемпотентность

Функция КлючИдемпотентностиДопустим(Ключ)
	Если Не СтрНачинаетсяС(Ключ, "outbox:") Или СтрДлина(Ключ) < 8 Или СтрДлина(Ключ) > 135 Тогда
		Возврат Ложь;
	КонецЕсли;
	ДопустимыеСимволы = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-";
	Для Индекс = 8 По СтрДлина(Ключ) Цикл
		Если СтрНайти(ДопустимыеСимволы, Сред(Ключ, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура ЗаблокироватьРезультат(Ключ)
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.AvtoPultИдемпотентность");
	ЭлементБлокировки.УстановитьЗначение("Ключ", Ключ);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция СохранитьТерминальнуюОшибку(Ключ, Операция, Хеш, ПодготовленныйОтвет)
	// Rollback released the original lock; another request may already have completed.
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРезультат(Ключ);
		Повтор = НайтиРезультат(Ключ);
		Если Повтор <> Неопределено Тогда
			Если Повтор.Операция <> Операция Или Повтор.ХешЗапроса <> Хеш Тогда
				ОтменитьТранзакцию();
				Возврат ОтветОшибки(409, "IDEMPOTENCY_CONFLICT", "Ключ уже использован с другим телом", Ложь);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
			Возврат СохраненныйОтвет(Повтор);
		КонецЕсли;
		СохранитьРезультат(Ключ, Операция, Хеш, ПодготовленныйОтвет.КодHTTP, ПодготовленныйОтвет.Тело);
		ЗафиксироватьТранзакцию();
		Возврат JSONОтвет(ПодготовленныйОтвет.КодHTTP, ПодготовленныйОтвет.Тело);
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция НайтиРезультат(Ключ)
	Набор = РегистрыСведений.AvtoPultИдемпотентность.СоздатьНаборЗаписей();
	Набор.Отбор.Ключ.Установить(Ключ);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Набор[0];
КонецФункции

Процедура СохранитьРезультат(Ключ, Операция, Хеш, КодОтвета, ТелоОтвета)
	Набор = РегистрыСведений.AvtoPultИдемпотентность.СоздатьНаборЗаписей();
	Набор.Отбор.Ключ.Установить(Ключ);
	Запись = Набор.Добавить();
	Запись.Ключ = Ключ;
	Запись.Операция = Операция;
	Запись.ХешЗапроса = Хеш;
	Запись.КодОтвета = КодОтвета;
	Запись.ТелоОтвета = ТелоОтвета;
	Запись.ЗавершеноВ = ТекущаяДатаСеанса();
	Набор.Записать();
КонецПроцедуры

#КонецОбласти

#Область JSON

Функция ОтветДиагностики(Запрос) Экспорт
	Если НормализоватьСтроку(Запрос.Заголовки.Получить("X-AvtoPult-Contract-Version")) <> "1.0" Тогда
		Возврат ОтветОшибки(400, "CONTRACT_VERSION_UNSUPPORTED", "Требуется версия контракта 1.0", Ложь);
	КонецЕсли;
	Возврат JSONОтвет(200, СериализоватьJSON(Новый Структура("ok", Истина)));
КонецФункции

Функция SHA256(Текст) Экспорт
	// Hash UTF-8 bytes without a BOM, independently of configuration-specific business code.
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

Функция НормализоватьСтроку(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция ПрочитатьТелоJSON(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	// Handlers use named structure properties, not Map.Get().
	Результат = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция СериализоватьJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция JSONОтвет(Код, Тело)
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("X-AvtoPult-Contract-Version", "1.0");
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ПустойОтвет(Код)
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("X-AvtoPult-Contract-Version", "1.0");
	Возврат Ответ;
КонецФункции

Функция ДвоичныйОтвет(Код, Данные, ContentType)
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", ContentType);
	Ответ.Заголовки.Вставить("Cache-Control", "private, no-store");
	Ответ.Заголовки.Вставить("X-AvtoPult-Contract-Version", "1.0");
	Ответ.УстановитьТелоИзДвоичныхДанных(Данные);
	Возврат Ответ;
КонецФункции

Функция ОтветОшибки(КодHTTP, Код, Сообщение, Повторяемая)
	Возврат JSONОтвет(КодHTTP, СериализоватьJSON(Новый Структура(
		"contractVersion,code,message,retryable", "1.0", Код, Сообщение, Повторяемая)));
КонецФункции

Функция СохраненныйОтвет(Запись)
	Возврат JSONОтвет(Запись.КодОтвета, Запись.ТелоОтвета);
КонецФункции

#КонецОбласти
