// Destructive-looking but transactionally reversible acceptance for the test infobase only.
// Both posting attempts are always rolled back; this module never commits a document.

Функция ПроверитьОткатПроведения(Ссылка, ИменаРегистров) Экспорт
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "ACCEPTANCE_OUTER_TRANSACTION_FORBIDDEN";
	КонецЕсли;
	ПроверитьЧистоеСостояние(Ссылка);

	// First prove that the confirmed movement profile can post the document.
	НачатьТранзакцию();
	Попытка
		РезультатПроведения = AvtoPultПроведение.ПровестиИПроверить(Ссылка, ИменаРегистров);
		Если Не РезультатПроведения.Успех Или Не РезультатПроведения.Проведен Тогда
			ВызватьИсключение "ACCEPTANCE_POSTING_NOT_CONFIRMED";
		КонецЕсли;
		ОтменитьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	ПроверитьЧистоеСостояние(Ссылка);

	// Then fail after successful posting and all expected movement checks.
	ПрофильСОшибкой = Новый Массив;
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		ПрофильСОшибкой.Добавить(ИмяРегистра);
	КонецЦикла;
	ПрофильСОшибкой.Добавить("__AvtoPultMissingRegisterAfterPosting__");
	ОжидаемаяОшибкаПолучена = Ложь;
	НачатьТранзакцию();
	Попытка
		AvtoPultПроведение.ПровестиИПроверить(Ссылка, ПрофильСОшибкой);
		ОтменитьТранзакцию();
	Исключение
		ОжидаемаяОшибкаПолучена = Истина;
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
	КонецПопытки;
	Если Не ОжидаемаяОшибкаПолучена Тогда
		ВызватьИсключение "ACCEPTANCE_FORCED_FAILURE_NOT_OBSERVED";
	КонецЕсли;
	ПроверитьЧистоеСостояние(Ссылка);

	Возврат Новый Структура("Успех,УспешноеПроведениеОтменено,ОшибкаПослеПроведенияОтменена",
		Истина, Истина, Истина);
КонецФункции

Процедура ПроверитьЧистоеСостояние(Ссылка)
	Документ = Ссылка.ПолучитьОбъект();
	Если Документ = Неопределено Или Документ.ПометкаУдаления Тогда
		ВызватьИсключение "ACCEPTANCE_DOCUMENT_UNAVAILABLE";
	КонецЕсли;
	Если Документ.Проведен Тогда
		ВызватьИсключение "ACCEPTANCE_REQUIRES_UNPOSTED_DOCUMENT";
	КонецЕсли;
	Диагностика = AvtoPultДиагностикаКА2.НайтиРегистрыДвижений(Ссылка);
	Если Не Диагностика.Успех Тогда
		ВызватьИсключение "ACCEPTANCE_MOVEMENT_SCAN_FAILED";
	КонецЕсли;
	Если Диагностика.Регистры.Количество() <> 0 Тогда
		ВызватьИсключение "ACCEPTANCE_ROLLBACK_LEFT_MOVEMENTS";
	КонецЕсли;
КонецПроцедуры
