Функция ПрименитьЗаказКлиента(Payload) Экспорт
	ПроверитьТранзакцию();
	Проблема = AvtoPultКонтракт.ПроверитьЗаказ(Payload);
	Если Проблема <> Неопределено Тогда
		Возврат Проблема;
	КонецЕсли;
	Возврат AvtoPultЗаказы.Применить(Payload);
КонецФункции

Функция СоздатьИлиНайтиСчет(Payload) Экспорт
	ПроверитьТранзакцию();
	Возврат AvtoPultСчета.Создать(Payload);
КонецФункции

// Internal entry point. A verified configuration profile supplies the expected registers.
Функция ПровестиДокумент(Ссылка, ИменаРегистров) Экспорт
	ПроверитьТранзакцию();
	Возврат AvtoPultПроведение.ПровестиИПроверить(Ссылка, ИменаРегистров);
КонецФункции

Функция ПрименитьНачисления(Payload) Экспорт
	ПроверитьТранзакцию();
	// Payroll is deliberately unsupported until its native document mapping is verified.
	Возврат AvtoPultКонтракт.Ошибка("PAYROLL_MAPPING_UNVERIFIED",
		"Сопоставление документов начислений не подтверждено в этой конфигурации");
КонецФункции

Процедура ПроверитьТранзакцию()
	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "AvtoPult adapter requires the transport transaction";
	КонецЕсли;
КонецПроцедуры
