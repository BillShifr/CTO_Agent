// FR-INT-001/006: native draft persistence; the caller owns the transaction.
Функция Применить(Payload) Экспорт
	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "TRANSACTION_REQUIRED"; КонецЕсли;
	Ошибка = AvtoPultКонтракт.ПроверитьЗаказ(Payload);
	Если Ошибка <> Неопределено Тогда Возврат Ошибка; КонецЕсли;
	Заказ = Payload.workOrder;
	Если Заказ.status <> "draft" И Заказ.status <> "created" И Заказ.status <> "new" Тогда
		Возврат AvtoPultКонтракт.Ошибка("STATUS_MAPPING_REQUIRED", "Переход требует проверенного сопоставления статусов", 409);
	КонецЕсли;
	Заблокировать("РегистрСведений.AvtoPultЗаказы", "WorkOrderId", Заказ.workOrderId);
	Связь = РегистрыСведений.AvtoPultЗаказы.СоздатьМенеджерЗаписи();
	Связь.WorkOrderId = Заказ.workOrderId;
	Связь.Прочитать();
	Хеш = AvtoPultИнтеграция.SHA256(AvtoPultКонтракт.JSON(Payload));
	Если Связь.Выбран() Тогда
		Если Заказ.version < Связь.Версия Тогда
			Ошибка = AvtoPultКонтракт.Ошибка("STALE_VERSION", "Версия заказа устарела", 409);
			Ошибка.Вставить("ТекущаяВерсия", Связь.Версия);
			Возврат Ошибка;
		КонецЕсли;
		Если Заказ.version = Связь.Версия Тогда
			Если Хеш <> Связь.Хеш Тогда
				Возврат AvtoPultКонтракт.Ошибка("VERSION_CONFLICT", "Одна версия содержит разные данные", 409);
			КонецЕсли;
			Возврат Успех(Связь, "replayed");
		КонецЕсли;
		Если Связь.СчетВыставлен Тогда
			Возврат AvtoPultКонтракт.Ошибка("INVOICE_LOCKED", "Заказ заблокирован после выставления счета", 409);
		КонецЕсли;
	КонецЕсли;
	ВнешнийИдентификатор = AvtoPultКонтракт.Свойство(Заказ, "externalId", "");
	Если ВнешнийИдентификатор <> "" Тогда
		Если Не Связь.Выбран() Тогда
			Возврат AvtoPultКонтракт.Ошибка("ORDER_BINDING_REQUIRED", "Заказ отсутствует в реестре интеграции", 409);
		КонецЕсли;
		Если ВнешнийИдентификатор <> Строка(Связь.ЗаказКлиента.УникальныйИдентификатор()) Тогда
			Возврат AvtoPultКонтракт.Ошибка("ORDER_ID_CONFLICT", "Внешний идентификатор заказа не совпадает", 409);
		КонецЕсли;
	КонецЕсли;
	Профиль = ПрочитатьСвязь("AvtoPultПрофилиСтанций", "StationId", Заказ.stationExternalId);
	Клиент = ПрочитатьСвязь("AvtoPultКлиенты", "ClientId", Заказ.clientId);
	Автомобиль = ПрочитатьСвязь("AvtoPultАвтомобили", "VehicleId", Заказ.vehicleId);
	Если Не Профиль.Выбран() Или Не Клиент.Выбран() Или Не Автомобиль.Выбран() Тогда
		Возврат AvtoPultКонтракт.Ошибка("REFERENCE_MAPPING_REQUIRED", "Не настроены точные соответствия станции, клиента или автомобиля", 409);
	КонецЕсли;
	Если Не Профиль.Проверен Или Не Профиль.БезНДСПодтверждено
		Или Не ЗначениеЗаполнено(Профиль.ОбразецЗаказа)
		Или Не ЗначениеЗаполнено(Клиент.Партнер) Или Не ЗначениеЗаполнено(Клиент.Контрагент)
		Или Не ЗначениеЗаполнено(Автомобиль.Автомобиль) Тогда
		Возврат AvtoPultКонтракт.Ошибка("PROFILE_NOT_VERIFIED", "Профиль записи не подтвержден на тестовой базе", 409);
	КонецЕсли;
	Если Клиент.Партнер.ПометкаУдаления Или Клиент.Контрагент.ПометкаУдаления
		Или Автомобиль.Автомобиль.ПометкаУдаления
		Или Клиент.Контрагент.Партнер <> Клиент.Партнер Тогда
		Возврат AvtoPultКонтракт.Ошибка("REFERENCE_MAPPING_INVALID", "Связанные справочники требуют проверки", 409);
	КонецЕсли;
	Заблокировать("Документ.ЗаказКлиента", "Ссылка", Профиль.ОбразецЗаказа);
	Образец = Профиль.ОбразецЗаказа.ПолучитьОбъект();
	Если Образец = Неопределено Или Образец.ПометкаУдаления Или Образец.Проведен
		Или Образец.Товары.Количество() <> 1 Или Образец.Товары[0].СуммаНДС <> 0 Тогда
		Возврат AvtoPultКонтракт.Ошибка("PROFILE_TEMPLATE_INVALID", "Требуется проверенный непроведенный образец с одной строкой без НДС", 409);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Образец.Организация) Или Не ЗначениеЗаполнено(Образец.Склад)
		Или Не ЗначениеЗаполнено(Образец.Валюта) Или Не ЗначениеЗаполнено(Образец.Соглашение)
		Или Не ЗначениеЗаполнено(Образец.Товары[0].СтавкаНДС) Тогда
		Возврат AvtoPultКонтракт.Ошибка("PROFILE_TEMPLATE_INCOMPLETE", "В образце не заполнены обязательные настройки", 409);
	КонецЕсли;
	Если Связь.Выбран() Тогда
		Заблокировать("Документ.ЗаказКлиента", "Ссылка", Связь.ЗаказКлиента);
		Документ = Связь.ЗаказКлиента.ПолучитьОбъект();
		Если Документ = Неопределено Тогда
			Возврат AvtoPultКонтракт.Ошибка("ORDER_NOT_FOUND", "Документ заказа не найден", 404);
		КонецЕсли;
		Если Документ.Проведен Или Документ.ПометкаУдаления Тогда
			Возврат AvtoPultКонтракт.Ошибка("ORDER_NOT_EDITABLE", "Проведенный или удаленный заказ не изменяется", 409);
		КонецЕсли;
		Если ЕстьСчет(Документ.Ссылка) Тогда
			Возврат AvtoPultКонтракт.Ошибка("INVOICE_LOCKED", "К заказу уже выставлен счет в 1С", 409);
		КонецЕсли;
		Если ВерсияДокумента(Документ.Ссылка) <> Связь.Версия1С Тогда
			Возврат AvtoPultКонтракт.Ошибка("NATIVE_VERSION_CONFLICT", "Заказ изменен в 1С; требуется сверка", 409);
		КонецЕсли;
		Если Связь.StationId <> Заказ.stationExternalId Или Связь.ClientId <> Заказ.clientId
			Или Связь.VehicleId <> Заказ.vehicleId Тогда
			Возврат AvtoPultКонтракт.Ошибка("ORDER_IDENTITY_CONFLICT", "Смена станции, клиента или автомобиля требует отдельной операции", 409);
		КонецЕсли;
		Результат = "updated";
	Иначе
		Документ = Документы.ЗаказКлиента.СоздатьДокумент();
		Документ.Дата = ТекущаяДатаСеанса();
		ЗаполнитьЗначенияСвойств(Документ, Образец,
			"Организация,Подразделение,Соглашение,Валюта,Склад,ЦенаВключаетНДС,НалогообложениеНДС,ХозяйственнаяОперация,Статус,ПорядокРасчетов,ФормаОплаты");
		Документ.Партнер = Клиент.Партнер;
		Документ.Контрагент = Клиент.Контрагент;
		Документ.Автомобиль = Автомобиль.Автомобиль;
		Результат = "created";
	КонецЕсли;
	Ошибка = ЗаполнитьСтроки(Документ, Образец, Заказ);
	Если Ошибка <> Неопределено Тогда Возврат Ошибка; КонецЕсли;
	Документ.СуммаДокумента = AvtoPultКонтракт.Тиыны(Заказ.totalTiyn) / 100;
	ОжидаемыйСнимокJSON = AvtoPultИзмененияЗаказов.СнимокЗаписиJSON(Документ);
	// Never post or enable data-exchange bypass: native validation remains active.
	AvtoPultИзмененияЗаказов.ЗаписатьИзОблака(Документ, Заказ.version, Payload);
	// Read stored values: native handlers and numeric qualifiers must not silently alter money.
	Документ = Документ.Ссылка.ПолучитьОбъект();
	// OnWrite alone is not final evidence: later native handlers may change the document.
	Если ОжидаемыйСнимокJSON <> AvtoPultИзмененияЗаказов.СнимокЗаписиJSON(Документ) Тогда
		Возврат AvtoPultКонтракт.Ошибка("NATIVE_PROJECTION_CHANGED", "1С изменила поля заказа; запись отменена", 409);
	КонецЕсли;
	Если Не СохраненныйСоставСовпадает(Документ, Заказ)
		Или Документ.Партнер <> Клиент.Партнер Или Документ.Контрагент <> Клиент.Контрагент
		Или Документ.Автомобиль <> Автомобиль.Автомобиль Тогда
		Возврат AvtoPultКонтракт.Ошибка("NATIVE_VALUES_CHANGED", "1С изменила сумму или состав; запись отменена", 409);
	КонецЕсли;
	Связь.WorkOrderId = Заказ.workOrderId;
	Связь.ЗаказКлиента = Документ.Ссылка;
	Связь.Версия = Заказ.version;
	Связь.Хеш = Хеш;
	Связь.Версия1С = ВерсияДокумента(Документ.Ссылка);
	Связь.StationId = Заказ.stationExternalId;
	Связь.ClientId = Заказ.clientId;
	Связь.VehicleId = Заказ.vehicleId;
	Связь.PayloadJSON = AvtoPultКонтракт.JSON(Payload);
	Связь.Записать();
	Возврат Успех(Связь, Результат);
КонецФункции

Функция ЗаполнитьСтроки(Документ, Образец, Заказ)
	Документ.Товары.Очистить();
	СуммаТиын = 0;
	Для Каждого Позиция Из Заказ.items Цикл
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Позиция.externalId));
		ОбъектНоменклатуры = Номенклатура.ПолучитьОбъект();
		Если ОбъектНоменклатуры = Неопределено Или ОбъектНоменклатуры.ПометкаУдаления Или ОбъектНоменклатуры.ЭтоГруппа Тогда
			Возврат AvtoPultКонтракт.Ошибка("ITEM_NOT_FOUND", "Номенклатура недоступна", 422);
		КонецЕсли;
		Ключ = РегистрыСведений.AvtoPultСтрокиЗаказов.СоздатьМенеджерЗаписи();
		Ключ.WorkOrderId = Заказ.workOrderId;
		Ключ.ItemId = Позиция.itemId;
		Ключ.Прочитать();
		Если Ключ.Выбран() Тогда
			Если Ключ.Номенклатура <> Номенклатура Тогда
				Возврат AvtoPultКонтракт.Ошибка("ITEM_ID_CONFLICT", "Идентификатор строки уже связан с другой номенклатурой", 409);
			КонецЕсли;
		Иначе
			Документ.МаксимальныйКодСтроки = Документ.МаксимальныйКодСтроки + 1;
			Ключ.КодСтроки = Документ.МаксимальныйКодСтроки;
			Ключ.Номенклатура = Номенклатура;
			Ключ.Записать();
		КонецЕсли;
		СтрокаТоваров = Документ.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТоваров, Образец.Товары[0], "СтавкаНДС,ВариантОбеспечения,ВидЦены");
		СтрокаТоваров.КодСтроки = Ключ.КодСтроки;
		СтрокаТоваров.Номенклатура = Номенклатура;
		СтрокаТоваров.Склад = Документ.Склад;
		СтрокаТоваров.Количество = Позиция.quantity;
		СтрокаТоваров.КоличествоУпаковок = Позиция.quantity;
		СтрокаТоваров.Цена = AvtoPultКонтракт.Тиыны(Позиция.priceTiyn) / 100;
		Стоимость = AvtoPultКонтракт.СуммаСтроки(AvtoPultКонтракт.Тиыны(Позиция.priceTiyn), Позиция.quantity);
		СтрокаТоваров.Сумма = Стоимость / 100;
		СтрокаТоваров.СуммаНДС = 0;
		СтрокаТоваров.СуммаСНДС = Стоимость / 100;
		СуммаТиын = СуммаТиын + Стоимость;
	КонецЦикла;
	Если СуммаТиын <> AvtoPultКонтракт.Тиыны(Заказ.totalTiyn) Тогда
		Возврат AvtoPultКонтракт.Ошибка("ORDER_TOTAL_MISMATCH", "Итог заказа не совпадает с суммой строк", 422);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция СохраненныйСоставСовпадает(Документ, Заказ)
	Если Документ.Проведен Или Документ.СуммаДокумента * 100 <> AvtoPultКонтракт.Тиыны(Заказ.totalTiyn)
		Или Документ.Товары.Количество() <> Заказ.items.Количество() Тогда Возврат Ложь; КонецЕсли;
	Для Индекс = 0 По Заказ.items.Количество() - 1 Цикл
		Позиция = Заказ.items[Индекс];
		СтрокаТоваров = Документ.Товары[Индекс];
		Ключ = РегистрыСведений.AvtoPultСтрокиЗаказов.СоздатьМенеджерЗаписи();
		Ключ.WorkOrderId = Заказ.workOrderId;
		Ключ.ItemId = Позиция.itemId;
		Ключ.Прочитать();
		Если СтрокаТоваров.Количество <> Позиция.quantity
			Или СтрокаТоваров.КодСтроки <> Ключ.КодСтроки Или СтрокаТоваров.Склад <> Документ.Склад
			Или СтрокаТоваров.Отменено
			Или СтрокаТоваров.Цена * 100 <> AvtoPultКонтракт.Тиыны(Позиция.priceTiyn)
			Или СтрокаТоваров.Сумма * 100 <> AvtoPultКонтракт.СуммаСтроки(AvtoPultКонтракт.Тиыны(Позиция.priceTiyn), Позиция.quantity)
			Или СтрокаТоваров.СуммаСНДС <> СтрокаТоваров.Сумма Или СтрокаТоваров.СуммаНДС <> 0
			Или Строка(СтрокаТоваров.Номенклатура.УникальныйИдентификатор()) <> НРег(Позиция.externalId) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЕстьСчет(Ссылка)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.СчетНаОплатуКлиенту
		|ГДЕ ДокументОснование = &Заказ И НЕ ПометкаУдаления И НЕ Аннулирован");
	Запрос.УстановитьПараметр("Заказ", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Процедура Заблокировать(Область, Поле, Значение)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Область);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение(Поле, Значение);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ПрочитатьСвязь(ИмяРегистра, Поле, Значение)
	Заблокировать("РегистрСведений." + ИмяРегистра, Поле, Значение);
	Запись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	Запись[Поле] = Значение;
	Запись.Прочитать();
	Возврат Запись;
КонецФункции

Функция ВерсияДокумента(Ссылка)
	Запрос = Новый Запрос("ВЫБРАТЬ ВерсияДанных ИЗ Документ.ЗаказКлиента ГДЕ Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда ВызватьИсключение "ORDER_VERSION_UNAVAILABLE"; КонецЕсли;
	Возврат Base64Строка(Выборка.ВерсияДанных);
КонецФункции

Функция Успех(Связь, Результат)
	Данные = Новый Структура("contractVersion,externalId,version,result", "1.0",
		Строка(Связь.ЗаказКлиента.УникальныйИдентификатор()), Связь.Версия, Результат);
	Возврат Новый Структура("Успех,Данные", Истина, Данные);
КонецФункции
