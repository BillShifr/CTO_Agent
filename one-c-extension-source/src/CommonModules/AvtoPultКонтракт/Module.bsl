Функция Свойство(Объект, Имя, ПоУмолчанию = Неопределено) Экспорт
	Если ТипЗнч(Объект) = Тип("Структура") И Объект.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция Ошибка(Код, Сообщение, КодHTTP = 422) Экспорт
	Возврат Новый Структура("Успех,КодHTTP,Код,Сообщение,Повторяемая",
		Ложь, КодHTTP, Код, Сообщение, Ложь);
КонецФункции

Функция JSON(Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ИдентификаторДопустим(Значение) Экспорт
	Возврат ТипЗнч(Значение) = Тип("Строка")
		И СтрДлина(Значение) > 0 И СтрДлина(Значение) <= 128
		И СокрЛП(Значение) = Значение;
КонецФункции

Функция GUIDДопустим(Значение) Экспорт
	Если Не ИдентификаторДопустим(Значение) Или СтрДлина(Значение) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		GUID = Новый УникальныйИдентификатор(Значение);
		Возврат НРег(Строка(GUID)) = НРег(Значение)
			И Значение <> "00000000-0000-0000-0000-000000000000";
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ЦелоеВДиапазоне(Значение, Минимум, Максимум) Экспорт
	Возврат ТипЗнч(Значение) = Тип("Число")
		И Значение >= Минимум И Значение <= Максимум И Цел(Значение) = Значение;
КонецФункции

Функция ДеньгиДопустимы(Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) = 0
		Или СтрДлина(Значение) > 19 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(Значение) > 1 И Лев(Значение, 1) = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Число(Значение) <= 9223372036854775807;
КонецФункции

Функция Тиыны(Значение) Экспорт
	Если Не ДеньгиДопустимы(Значение) Тогда
		ВызватьИсключение "Invalid canonical tiyn amount";
	КонецЕсли;
	Возврат Число(Значение);
КонецФункции

Функция СуммаСтроки(ЦенаТиын, Количество) Экспорт
	// Match work-order-total.ts: positive quantities, round half up in integer tiyn.
	Возврат Цел((ЦенаТиын * Количество * 1000 + 500) / 1000);
КонецФункции

Функция ПроверитьЗаказ(Payload) Экспорт
	Заказ = Свойство(Payload, "workOrder");
	Если Свойство(Payload, "contractVersion") <> "1.0" Или ТипЗнч(Заказ) <> Тип("Структура") Тогда
		Возврат Ошибка("REQUEST_BODY_INVALID", "Требуется заказ контракта 1.0", 400);
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("workOrderId,clientId,vehicleId,stationExternalId", ",") Цикл
		Если Не ИдентификаторДопустим(Свойство(Заказ, Имя)) Тогда
			Возврат Ошибка("REEXPORT_REQUIRED", "Требуется актуальный снимок со стабильными идентификаторами");
		КонецЕсли;
	КонецЦикла;
	Если Не ЦелоеВДиапазоне(Свойство(Заказ, "version"), 1, 2147483647)
		Или Не ДеньгиДопустимы(Свойство(Заказ, "totalTiyn")) Тогда
		Возврат Ошибка("ORDER_VALUE_INVALID", "Недопустимы версия или сумма заказа");
	КонецЕсли;
	Если Не ИдентификаторДопустим(Свойство(Заказ, "status")) Тогда
		Возврат Ошибка("ORDER_STATUS_INVALID", "Не задан статус заказа");
	КонецЕсли;
	Если Свойство(Заказ, "externalId") <> Неопределено
		И Не GUIDДопустим(Заказ.externalId) Тогда
		Возврат Ошибка("ORDER_REFERENCE_INVALID", "Недопустим идентификатор заказа 1С");
	КонецЕсли;
	ТипКлиента = Свойство(Свойство(Заказ, "client"), "type");
	Если (ТипКлиента <> "person" И ТипКлиента <> "legal_entity")
		Или ТипЗнч(Свойство(Заказ, "vehicle")) <> Тип("Структура") Тогда
		Возврат Ошибка("CUSTOMER_VALUE_INVALID", "Не заданы клиент или автомобиль");
	КонецЕсли;
	Строки = Свойство(Заказ, "items");
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Возврат Ошибка("ORDER_ITEMS_INVALID", "Не заданы строки заказа");
	КонецЕсли;
	Идентификаторы = Новый Соответствие;
	Сумма = 0;
	Для Каждого СтрокаЗаказа Из Строки Цикл
		Проблема = ПроверитьСтроку(СтрокаЗаказа);
		Если Проблема <> Неопределено Тогда
			Возврат Проблема;
		КонецЕсли;
		Если Идентификаторы.Получить(СтрокаЗаказа.itemId) <> Неопределено Тогда
			Возврат Ошибка("DUPLICATE_ITEM_ID", "Идентификатор строки повторяется");
		КонецЕсли;
		Идентификаторы.Вставить(СтрокаЗаказа.itemId, Истина);
		Сумма = Сумма + СуммаСтроки(Тиыны(СтрокаЗаказа.priceTiyn), СтрокаЗаказа.quantity);
		Если Сумма > 9223372036854775807 Тогда
			Возврат Ошибка("ORDER_TOTAL_OVERFLOW", "Сумма заказа превышает допустимую");
		КонецЕсли;
	КонецЦикла;
	Если Сумма <> Тиыны(Заказ.totalTiyn) Тогда
		Возврат Ошибка("ORDER_TOTAL_MISMATCH", "Сумма заказа не соответствует строкам");
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПроверитьСтроку(СтрокаЗаказа)
	Если Не ИдентификаторДопустим(Свойство(СтрокаЗаказа, "itemId"))
		Или Не GUIDДопустим(Свойство(СтрокаЗаказа, "externalId")) Тогда
		Возврат Ошибка("ITEM_REFERENCE_INVALID", "Не задана стабильная ссылка строки или номенклатуры");
	КонецЕсли;
	Количество = Свойство(СтрокаЗаказа, "quantity");
	Если ТипЗнч(Количество) <> Тип("Число") Или Количество <= 0
		Или Количество > 9999999.999 Или Цел(Количество * 1000) <> Количество * 1000
		Или Не ДеньгиДопустимы(Свойство(СтрокаЗаказа, "priceTiyn")) Тогда
		Возврат Ошибка("ITEM_VALUE_INVALID", "Недопустимы количество или цена строки");
	КонецЕсли;
	Если Не ЦелоеВДиапазоне(Свойство(СтрокаЗаказа, "mechanicShare"), 0, 100)
		Или ТипЗнч(Свойство(СтрокаЗаказа, "requiresApproval")) <> Тип("Булево") Тогда
		Возврат Ошибка("REEXPORT_REQUIRED", "Требуется снимок с параметрами согласования и доли механика");
	КонецЕсли;
	Если Свойство(СтрокаЗаказа, "type") = "service" Тогда
		Норма = Свойство(СтрокаЗаказа, "normHours");
		Если ТипЗнч(Норма) <> Тип("Число") Или Норма < 0 Или Норма > 9999.99
			Или Цел(Норма * 100) <> Норма * 100 Тогда
			Возврат Ошибка("ITEM_NORM_INVALID", "Недопустим норматив услуги");
		КонецЕсли;
	ИначеЕсли Свойство(СтрокаЗаказа, "type") <> "product"
		Или Свойство(СтрокаЗаказа, "normHours") <> Неопределено Тогда
		Возврат Ошибка("ITEM_TYPE_INVALID", "Недопустим тип строки");
	КонецЕсли;
	Возврат Неопределено;
КонецФункции
