// Native posting boundary. The transport owns the surrounding transaction.
// Expected registers must come from a profile verified on the customer's test infobase.

Функция ПровестиПоПрофилю(Ссылка, ИдентификаторПрофиля) Экспорт
	ПроверитьТранзакцию();
	ИменаРегистров = ПрочитатьПроверенныйПрофиль(Ссылка, ИдентификаторПрофиля);
	Возврат ПровестиИПроверить(Ссылка, ИменаРегистров);
КонецФункции

Функция ПровестиИПроверить(Ссылка, ИменаРегистров) Экспорт
	ПроверитьТранзакцию();
	ОбластьБлокировки = ОбластьПоддерживаемогоДокумента(Ссылка);
	Если ТипЗнч(ИменаРегистров) <> Тип("Массив") Или ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "POSTING_MOVEMENT_PROFILE_REQUIRED";
	КонецЕсли;

	ЗаблокироватьДокумент(ОбластьБлокировки, Ссылка);
	Документ = Ссылка.ПолучитьОбъект();
	Если Документ = Неопределено Или Документ.ПометкаУдаления Тогда
		ВызватьИсключение "POSTING_DOCUMENT_UNAVAILABLE";
	КонецЕсли;

	Если Не Документ.Проведен Тогда
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	Документ = Ссылка.ПолучитьОбъект();
	Если Документ = Неопределено Или Не Документ.Проведен Тогда
		ВызватьИсключение "POSTING_NOT_CONFIRMED";
	КонецЕсли;

	ПроверенныеРегистры = Новый Массив;
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Если ТипЗнч(ИмяРегистра) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(ИмяРегистра)) Тогда
			ВызватьИсключение "POSTING_REGISTER_NAME_INVALID";
		КонецЕсли;
		ИмяРегистра = СокрЛП(ИмяРегистра);
		Если ПроверенныеРегистры.Найти(ИмяРегистра) <> Неопределено Тогда
			ВызватьИсключение "POSTING_REGISTER_DUPLICATED";
		КонецЕсли;
		ОбъектМетаданных = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
		Если ОбъектМетаданных = Неопределено Тогда
			ВызватьИсключение "POSTING_REGISTER_UNAVAILABLE";
		КонецЕсли;
		ПроверитьДвижение(Ссылка, ОбъектМетаданных.Имя);
		ПроверенныеРегистры.Добавить(ИмяРегистра);
	КонецЦикла;

	Возврат Новый Структура("Успех,Проведен,ПровереноРегистров",
		Истина, Истина, ПроверенныеРегистры.Количество());
КонецФункции

Функция ПрочитатьПроверенныйПрофиль(Ссылка, ИдентификаторПрофиля)
	Если Не AvtoPultКонтракт.ИдентификаторДопустим(ИдентификаторПрофиля) Тогда
		ВызватьИсключение "POSTING_PROFILE_ID_INVALID";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
		| Профиль.ТипДокумента КАК ТипДокумента,
		| Профиль.РегистрыJSON КАК РегистрыJSON,
		| Профиль.SHA256 КАК SHA256
		|ИЗ РегистрСведений.AvtoPultПрофилиПроведения КАК Профиль
		|ГДЕ Профиль.PostingProfileId = &PostingProfileId
		| И Профиль.Проверен = ИСТИНА");
	Запрос.УстановитьПараметр("PostingProfileId", ИдентификаторПрофиля);
	Профили = Запрос.Выполнить().Выгрузить();
	Если Профили.Количество() <> 1 Тогда
		ВызватьИсключение "POSTING_PROFILE_NOT_VERIFIED";
	КонецЕсли;
	Профиль = Профили[0];
	Если Профиль.ТипДокумента <> ТипПоддерживаемогоДокумента(Ссылка) Тогда
		ВызватьИсключение "POSTING_PROFILE_DOCUMENT_MISMATCH";
	КонецЕсли;
	ИменаРегистров = ПрочитатьМассивJSON(Профиль.РегистрыJSON);
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "POSTING_MOVEMENT_PROFILE_REQUIRED";
	КонецЕсли;
	ДанныеХеша = Новый Структура("documentType,registers", Профиль.ТипДокумента, ИменаРегистров);
	ОжидаемыйХеш = AvtoPultИнтеграция.SHA256(AvtoPultКонтракт.JSON(ДанныеХеша));
	Если НРег(СокрЛП(Профиль.SHA256)) <> ОжидаемыйХеш Тогда
		ВызватьИсключение "POSTING_PROFILE_HASH_MISMATCH";
	КонецЕсли;
	Возврат ИменаРегистров;
КонецФункции

Функция ПрочитатьМассивJSON(JSON)
	Если ТипЗнч(JSON) <> Тип("Строка") Или ПустаяСтрока(JSON) Тогда
		ВызватьИсключение "POSTING_PROFILE_JSON_INVALID";
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(JSON);
		Значение = ПрочитатьJSON(Чтение, Ложь);
		Чтение.Закрыть();
	Исключение
		ВызватьИсключение "POSTING_PROFILE_JSON_INVALID";
	КонецПопытки;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		ВызватьИсключение "POSTING_PROFILE_JSON_INVALID";
	КонецЕсли;
	Возврат Значение;
КонецФункции

Процедура ПроверитьДвижение(Ссылка, ИмяРегистра)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		| ИСТИНА КАК ЕстьДвижение
		|ИЗ РегистрНакопления." + ИмяРегистра + " КАК Движения
		|ГДЕ Движения.Регистратор = &Регистратор");
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "POSTING_MOVEMENT_NOT_FOUND";
	КонецЕсли;
КонецПроцедуры

Функция ОбластьПоддерживаемогоДокумента(Ссылка)
	Возврат СтрЗаменить(ТипПоддерживаемогоДокумента(Ссылка), "Document_", "Документ.");
КонецФункции

Функция ТипПоддерживаемогоДокумента(Ссылка)
	ТипСсылки = ТипЗнч(Ссылка);
	Если ТипСсылки = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Возврат "Document_ЗаказКлиента";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетНаОплатуКлиенту") Тогда
		Возврат "Document_СчетНаОплатуКлиенту";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		Возврат "Document_ПриходныйКассовыйОрдер";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Тогда
		Возврат "Document_ПоступлениеБезналичныхДенежныхСредств";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ОперацияПоПлатежнойКарте") Тогда
		Возврат "Document_ОперацияПоПлатежнойКарте";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		Возврат "Document_РасходныйКассовыйОрдер";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") Тогда
		Возврат "Document_СписаниеБезналичныхДенежныхСредств";
	КонецЕсли;
	ВызватьИсключение "POSTING_DOCUMENT_TYPE_UNSUPPORTED";
КонецФункции

Процедура ЗаблокироватьДокумент(Область, Ссылка)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Область);
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьТранзакцию()
	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "POSTING_TRANSACTION_REQUIRED";
	КонецЕсли;
КонецПроцедуры
