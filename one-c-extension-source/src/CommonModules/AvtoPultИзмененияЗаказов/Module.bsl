// FR-INT-006: capture native revisions; delivery requires explicit version reconciliation.
// Subscribe to DocumentObject.ЗаказКлиента.OnWrite, never to a form event.
Процедура ПриЗаписиЗаказа(Источник, Отказ) Экспорт
	Если Отказ Тогда Возврат; КонецЕсли;
	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "TRANSACTION_REQUIRED"; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 WorkOrderId, Версия, PayloadJSON
		|ИЗ РегистрСведений.AvtoPultЗаказы ГДЕ ЗаказКлиента = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Связи = Запрос.Выполнить().Выгрузить();
	Если Связи.Количество() = 0 Тогда Возврат; КонецЕсли;
	Если Связи.Количество() <> 1 Тогда ВызватьИсключение "AMBIGUOUS_ORDER_BINDING"; КонецЕсли;
	Связь = Связи[0];
	ЗаблокироватьГолову(Связь.WorkOrderId);
	Голова = РегистрыСведений.AvtoPultГоловыИзмененийЗаказов.СоздатьМенеджерЗаписи();
	Голова.WorkOrderId = Связь.WorkOrderId;
	Голова.Прочитать();
	ПредыдущаяРевизия = Голова.RevisionId;
	НомерРевизии = Голова.Sequence + 1;
	Если НомерРевизии > 999999999999999 Тогда ВызватьИсключение "REVISION_SEQUENCE_OVERFLOW"; КонецЕсли;
	Снимок = СнимокЗаказа(Источник);
	ЗафиксироватьИдентичностьСтрок(Снимок, Связь.WorkOrderId);
	СнимокJSON = AvtoPultКонтракт.JSON(Снимок);
	RevisionId = Строка(Новый УникальныйИдентификатор);
	Запись = РегистрыСведений.AvtoPultИзмененияЗаказов.СоздатьМенеджерЗаписи();
	Запись.WorkOrderId = Связь.WorkOrderId;
	Запись.Sequence = НомерРевизии;
	Запись.RevisionId = RevisionId;
	Запись.ParentRevisionId = ПредыдущаяРевизия;
	Запись.ЗаказКлиента = Источник.Ссылка;
	Запись.BaseVersion = Связь.Версия;
	ИсточникЗаписи = ОпределитьИсточник(Источник.ДополнительныеСвойства);
	Если ИсточникЗаписи.origin = "cloud" И ИсточникЗаписи.workOrderId <> Связь.WorkOrderId Тогда
		ВызватьИсключение "COMMAND_ORDER_MISMATCH";
	КонецЕсли;
	Запись.Origin = ИсточникЗаписи.origin;
	Запись.CommandVersion = ИсточникЗаписи.commandVersion;
	Запись.AcceptedCloudPayloadJSON = ИсточникЗаписи.payloadJSON;
	Запись.AcceptedCloudPayloadSHA256 = ИсточникЗаписи.payloadSHA256;
	Запись.BasePayloadJSON = Связь.PayloadJSON;
	Запись.PayloadJSON = СнимокJSON;
	Запись.SHA256 = AvtoPultИнтеграция.SHA256(СнимокJSON);
	Запись.СозданоВ = ТекущаяУниверсальнаяДата();
	Запись.Состояние = "pending";
	// Do not overwrite a revision even if a damaged head points backwards.
	Проверка = РегистрыСведений.AvtoPultИзмененияЗаказов.СоздатьМенеджерЗаписи();
	Проверка.WorkOrderId = Связь.WorkOrderId;
	Проверка.Sequence = НомерРевизии;
	Проверка.Прочитать();
	Если Проверка.Выбран() Тогда ВызватьИсключение "REVISION_ALREADY_EXISTS"; КонецЕсли;
	Запись.Записать();
	Голова.RevisionId = RevisionId;
	Голова.Sequence = НомерРевизии;
	Голова.Записать();
КонецПроцедуры

// Queue exactly one native revision per order. Cloud-origin writes are durable audit records,
// but are never reflected back to AvtoPult.
Процедура ОбновитьОчередь(WorkOrderId) Экспорт
	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "TRANSACTION_REQUIRED"; КонецЕсли;
	ЗаблокироватьГолову(WorkOrderId);
	Пока Истина Цикл
		Ревизия = ПерваяНезавершеннаяРевизия(WorkOrderId);
		Если Ревизия = Неопределено Тогда Возврат; КонецЕсли;
		Если Ревизия.Состояние = "queued" Или СтрНачинаетсяС(Ревизия.Состояние, "blocked") Тогда Возврат; КонецЕсли;
		Если Ревизия.Origin = "cloud" Тогда
			ИзменитьСостояниеРевизии(Ревизия.WorkOrderId, Ревизия.Sequence, "suppressed");
			Продолжить;
		КонецЕсли;
		Если Ревизия.Origin <> "native" Тогда
			ИзменитьСостояниеРевизии(Ревизия.WorkOrderId, Ревизия.Sequence, "blocked_origin");
			Возврат;
		КонецЕсли;
		Попытка
			Событие = СобытиеИзРевизии(Ревизия);
		Исключение
			ИзменитьСостояниеРевизии(Ревизия.WorkOrderId, Ревизия.Sequence, "blocked_payload");
			Возврат;
		КонецПопытки;
		AvtoPultИнтеграция.ПоставитьСобытиеВОчердь(Ревизия.RevisionId, Событие);
		ИзменитьСостояниеРевизии(Ревизия.WorkOrderId, Ревизия.Sequence, "queued");
		Возврат;
	КонецЦикла;
КонецПроцедуры

// Called only while AvtoPultИнтеграция owns the global outbox lock. This preserves one lock
// order for pump and ACK: outbox -> revision head.
Процедура ПоставитьОжидающиеВОчердь() Экспорт
	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "TRANSACTION_REQUIRED"; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ WorkOrderId
		|ИЗ РегистрСведений.AvtoPultИзмененияЗаказов
		|ГДЕ Состояние = &Ожидает
		|УПОРЯДОЧИТЬ ПО WorkOrderId");
	Запрос.УстановитьПараметр("Ожидает", "pending");
	Обработано = 0;
	Для Каждого Строка Из Запрос.Выполнить().Выгрузить() Цикл
		ОбновитьОчередь(Строка.WorkOrderId);
		Обработано = Обработано + 1;
		Если Обработано >= 50 Тогда Прервать; КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Called by the outbox ACK in the same transaction as marking the event delivered.
Процедура ПодтвердитьДоставку(EventId, ВерсияОблака) Экспорт
	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "TRANSACTION_REQUIRED"; КонецЕсли;
	Если Не AvtoPultКонтракт.ЦелоеВДиапазоне(ВерсияОблака, 1, 9007199254740991) Тогда
		ВызватьИсключение "RESULT_VERSION_REQUIRED";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 WorkOrderId, Sequence, Состояние
		|ИЗ РегистрСведений.AvtoPultИзмененияЗаказов
		|ГДЕ RevisionId = &RevisionId");
	Запрос.УстановитьПараметр("RevisionId", EventId);
	Ревизии = Запрос.Выполнить().Выгрузить();
	Если Ревизии.Количество() <> 1 Тогда ВызватьИсключение "REVISION_ACK_MISMATCH"; КонецЕсли;
	Ревизия = Ревизии[0];
	ЗаблокироватьГолову(Ревизия.WorkOrderId);
	Если Ревизия.Состояние <> "queued" Тогда ВызватьИсключение "REVISION_NOT_QUEUED"; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 WorkOrderId, Версия
		|ИЗ РегистрСведений.AvtoPultЗаказы ГДЕ WorkOrderId = &WorkOrderId");
	Запрос.УстановитьПараметр("WorkOrderId", Ревизия.WorkOrderId);
	Связи = Запрос.Выполнить().Выгрузить();
	Если Связи.Количество() <> 1 Тогда ВызватьИсключение "ORDER_BINDING_REQUIRED"; КонецЕсли;
	Связь = РегистрыСведений.AvtoPultЗаказы.СоздатьМенеджерЗаписи();
	Связь.WorkOrderId = Ревизия.WorkOrderId;
	Связь.Прочитать();
	Если Не Связь.Выбран() Тогда ВызватьИсключение "ORDER_BINDING_REQUIRED"; КонецЕсли;
	Если ВерсияОблака <= Связь.Версия Тогда ВызватьИсключение "RESULT_VERSION_INVALID"; КонецЕсли;
	Связь.Версия = ВерсияОблака;
	Связь.Записать();
	ИзменитьСостояниеРевизии(Ревизия.WorkOrderId, Ревизия.Sequence, "delivered");
	ОбновитьОчередь(Ревизия.WorkOrderId);
КонецПроцедуры

Функция ПерваяНезавершеннаяРевизия(WorkOrderId)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 WorkOrderId, Sequence, RevisionId, ЗаказКлиента,
		| BasePayloadJSON, PayloadJSON, SHA256, СозданоВ, Состояние, Origin
		|ИЗ РегистрСведений.AvtoPultИзмененияЗаказов
		|ГДЕ WorkOrderId = &WorkOrderId
		| И Состояние <> &Доставлено И Состояние <> &Подавлено
		|УПОРЯДОЧИТЬ ПО Sequence");
	Запрос.УстановитьПараметр("WorkOrderId", WorkOrderId);
	Запрос.УстановитьПараметр("Доставлено", "delivered");
	Запрос.УстановитьПараметр("Подавлено", "suppressed");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда Возврат Неопределено; КонецЕсли;
	Возврат Выборка;
КонецФункции

Функция СобытиеИзРевизии(Ревизия)
	БазовыйPayload = ПрочитатьСтруктуруJSON(Ревизия.BasePayloadJSON);
	Снимок = ПрочитатьСтруктуруJSON(Ревизия.PayloadJSON);
	БазовыйЗаказ = AvtoPultКонтракт.Свойство(БазовыйPayload, "workOrder");
	Если ТипЗнч(БазовыйЗаказ) <> Тип("Структура") Или Снимок.schemaVersion <> 2 Тогда
		ВызватьИсключение "REVISION_REEXPORT_REQUIRED";
	КонецЕсли;
	БазовыеСтроки = AvtoPultКонтракт.Свойство(БазовыйЗаказ, "items");
	Если ТипЗнч(БазовыеСтроки) <> Тип("Массив") Тогда ВызватьИсключение "REVISION_ITEMS_REQUIRED"; КонецЕсли;
	Строки = Новый Массив;
	Для Каждого Позиция Из Снимок.items Цикл
		Если Позиция.identityState <> "matched" Или Не AvtoPultКонтракт.ИдентификаторДопустим(Позиция.itemId) Тогда
			ВызватьИсключение "REVISION_ITEM_IDENTITY_CONFLICT";
		КонецЕсли;
		БазоваяСтрока = НайтиБазовуюСтроку(БазовыеСтроки, Позиция.itemId);
		Если БазоваяСтрока = Неопределено Или БазоваяСтрока.externalId <> Позиция.catalogId Тогда
			ВызватьИсключение "REVISION_ITEM_BINDING_CONFLICT";
		КонецЕсли;
		Если Позиция.cancelled Тогда Продолжить; КонецЕсли;
		КоличествоТысячных = ТочноеЦелое(Позиция.quantity, 1000, "REVISION_QUANTITY_INVALID");
		ЦенаТиын = ТочноеЦелое(Позиция.price, 100, "REVISION_PRICE_INVALID");
		ТипСтроки = AvtoPultКонтракт.Свойство(БазоваяСтрока, "type");
		Норма = AvtoPultКонтракт.Свойство(БазоваяСтрока, "normHours");
		НормаСотых = ?(Норма = Неопределено, Неопределено,
			ТочноеЦелое(Норма, 100, "REVISION_NORM_INVALID"));
		СтрокаСобытия = Новый Структура("itemId,type,externalId,name,quantityThousandths,priceTiyn,normHoursHundredths,mechanicShare,requiresApproval",
			Позиция.itemId, ТипСтроки, Позиция.catalogId, AvtoPultКонтракт.Свойство(БазоваяСтрока, "name"),
			КаноническоеЦелое(КоличествоТысячных), КаноническоеЦелое(ЦенаТиын),
			?(НормаСотых = Неопределено, Неопределено, КаноническоеЦелое(НормаСотых)),
			AvtoPultКонтракт.Свойство(БазоваяСтрока, "mechanicShare"),
			AvtoPultКонтракт.Свойство(БазоваяСтрока, "requiresApproval"));
		Если (ТипСтроки <> "service" И ТипСтроки <> "product")
			Или Не AvtoPultКонтракт.ИдентификаторДопустим(СтрокаСобытия.name)
			Или Не AvtoPultКонтракт.ЦелоеВДиапазоне(СтрокаСобытия.mechanicShare, 0, 100)
			Или ТипЗнч(СтрокаСобытия.requiresApproval) <> Тип("Булево") Тогда
			ВызватьИсключение "REVISION_ITEM_METADATA_INVALID";
		КонецЕсли;
		Строки.Добавить(СтрокаСобытия);
	КонецЦикла;
	Версия = ТекущаяВерсияСвязи(Ревизия.WorkOrderId);
	Возврат Новый Структура("event,eventId,workOrderId,workOrderExternalId,baseVersion,externalVersion,changedAt,items",
		"workorder.changed", Ревизия.RevisionId, Ревизия.WorkOrderId, GUIDСсылки(Ревизия.ЗаказКлиента),
		Версия, Ревизия.SHA256, Формат(Ревизия.СозданоВ, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z", Строки);
КонецФункции

Функция ПрочитатьСтруктуруJSON(JSON)
	Если ТипЗнч(JSON) <> Тип("Строка") Или ПустаяСтрока(JSON) Тогда ВызватьИсключение "REVISION_JSON_REQUIRED"; КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(JSON);
	Результат = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда ВызватьИсключение "REVISION_JSON_INVALID"; КонецЕсли;
	Возврат Результат;
КонецФункции

Функция КаноническоеЦелое(Значение)
	Возврат Формат(Значение, "ЧГ=0;ЧДЦ=0");
КонецФункции

Функция НайтиБазовуюСтроку(Строки, ItemId)
	Найденная = Неопределено;
	Для Каждого Строка Из Строки Цикл
		Если AvtoPultКонтракт.Свойство(Строка, "itemId") = ItemId Тогда
			Если Найденная <> Неопределено Тогда ВызватьИсключение "REVISION_DUPLICATE_ITEM"; КонецЕсли;
			Найденная = Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Найденная;
КонецФункции

Функция ТочноеЦелое(Значение, Множитель, КодОшибки)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда ВызватьИсключение КодОшибки; КонецЕсли;
	Результат = Значение * Множитель;
	Если Результат < 0 Или Цел(Результат) <> Результат Или Результат > 9223372036854775807 Тогда
		ВызватьИсключение КодОшибки;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ТекущаяВерсияСвязи(WorkOrderId)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Версия ИЗ РегистрСведений.AvtoPultЗаказы ГДЕ WorkOrderId = &WorkOrderId");
	Запрос.УстановитьПараметр("WorkOrderId", WorkOrderId);
	Связи = Запрос.Выполнить().Выгрузить();
	Если Связи.Количество() <> 1 Или Не AvtoPultКонтракт.ЦелоеВДиапазоне(Связи[0].Версия, 1, 9007199254740991) Тогда
		ВызватьИсключение "ORDER_BINDING_REQUIRED";
	КонецЕсли;
	Возврат Связи[0].Версия;
КонецФункции

Процедура ИзменитьСостояниеРевизии(WorkOrderId, Sequence, Состояние)
	Запись = РегистрыСведений.AvtoPultИзмененияЗаказов.СоздатьМенеджерЗаписи();
	Запись.WorkOrderId = WorkOrderId;
	Запись.Sequence = Sequence;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда ВызватьИсключение "REVISION_NOT_FOUND"; КонецЕсли;
	Запись.Состояние = Состояние;
	Запись.Записать();
КонецПроцедуры

Процедура ЗаблокироватьГолову(WorkOrderId)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.AvtoPultГоловыИзмененийЗаказов");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("WorkOrderId", WorkOrderId);
	Блокировка.Заблокировать();
КонецПроцедуры

// Scope the marker to this object/write; native validation and posting policy stay unchanged.
Процедура ЗаписатьИзОблака(Документ, ВерсияКоманды, Payload) Экспорт
	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "TRANSACTION_REQUIRED"; КонецЕсли;
	ПроверитьКоманду(Payload, ВерсияКоманды);
	ExternalId = AvtoPultКонтракт.Свойство(Payload.workOrder, "externalId", "");
	Если ExternalId <> "" И ExternalId <> GUIDСсылки(Документ.Ссылка) Тогда
		ВызватьИсключение "COMMAND_DOCUMENT_MISMATCH";
	КонецЕсли;
	// Freeze before native handlers run; never recover provenance from the mutable binding.
	PayloadJSON = AvtoPultКонтракт.JSON(Payload);
	Свойства = Документ.ДополнительныеСвойства;
	БылМаркер = Свойства.Свойство("AvtoPultВерсияКоманды", ПрежнийМаркер);
	БылPayload = Свойства.Свойство("AvtoPultPayloadКоманды", ПрежнийPayload);
	Свойства.Вставить("AvtoPultВерсияКоманды", ВерсияКоманды);
	Свойства.Вставить("AvtoPultPayloadКоманды", PayloadJSON);
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ВосстановитьМаркер(Свойства, "AvtoPultВерсияКоманды", БылМаркер, ПрежнийМаркер);
		ВосстановитьМаркер(Свойства, "AvtoPultPayloadКоманды", БылPayload, ПрежнийPayload);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьМаркер(Свойства, "AvtoPultВерсияКоманды", БылМаркер, ПрежнийМаркер);
	ВосстановитьМаркер(Свойства, "AvtoPultPayloadКоманды", БылPayload, ПрежнийPayload);
КонецПроцедуры

Функция СнимокЗаписиJSON(Документ) Экспорт
	Снимок = СнимокЗаказа(Документ);
	// Creation allocates the reference during Write; retain every other captured field.
	Снимок.Удалить("externalId");
	Возврат AvtoPultКонтракт.JSON(Снимок);
КонецФункции

Функция ОпределитьИсточник(Свойства) Экспорт
	Если Не Свойства.Свойство("AvtoPultВерсияКоманды", ВерсияКоманды) Тогда
		Если Свойства.Свойство("AvtoPultPayloadКоманды") Тогда ВызватьИсключение "ORPHAN_COMMAND_PAYLOAD"; КонецЕсли;
		Возврат Новый Структура("origin,commandVersion,workOrderId,payloadJSON,payloadSHA256", "native", 0, "", "", "");
	КонецЕсли;
	Если Не Свойства.Свойство("AvtoPultPayloadКоманды", PayloadJSON) Тогда
		ВызватьИсключение "COMMAND_PAYLOAD_REQUIRED";
	КонецЕсли;
	Если ТипЗнч(PayloadJSON) <> Тип("Строка") Или ПустаяСтрока(PayloadJSON) Тогда
		ВызватьИсключение "COMMAND_PAYLOAD_REQUIRED";
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(PayloadJSON);
	Payload = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	ПроверитьКоманду(Payload, ВерсияКоманды);
	Возврат Новый Структура("origin,commandVersion,workOrderId,payloadJSON,payloadSHA256",
		"cloud", ВерсияКоманды, Payload.workOrder.workOrderId, PayloadJSON, AvtoPultИнтеграция.SHA256(PayloadJSON));
КонецФункции

Процедура ПроверитьКоманду(Payload, ВерсияКоманды)
	Если Не AvtoPultКонтракт.ЦелоеВДиапазоне(ВерсияКоманды, 1, 2147483647) Тогда
		ВызватьИсключение "INVALID_COMMAND_VERSION";
	КонецЕсли;
	Заказ = AvtoPultКонтракт.Свойство(Payload, "workOrder");
	Если AvtoPultКонтракт.Свойство(Заказ, "version") <> ВерсияКоманды Тогда
		ВызватьИсключение "COMMAND_VERSION_MISMATCH";
	КонецЕсли;
	Если AvtoPultКонтракт.ПроверитьЗаказ(Payload) <> Неопределено Тогда
		ВызватьИсключение "COMMAND_PAYLOAD_INVALID";
	КонецЕсли;
КонецПроцедуры

Процедура ВосстановитьМаркер(Свойства, Имя, БылМаркер, ПрежнийМаркер)
	Если БылМаркер Тогда
		Свойства.Вставить(Имя, ПрежнийМаркер);
	Иначе
		Свойства.Удалить(Имя);
	КонецЕсли;
КонецПроцедуры

Функция СнимокЗаказа(Источник)
	Снимок = Новый Структура("schemaVersion,externalId,posted,deletionMark,nativeStatus,total",
		1, GUIDСсылки(Источник.Ссылка), Источник.Проведен, Источник.ПометкаУдаления,
		Строка(Источник.Статус), Источник.СуммаДокумента);
	Снимок.Вставить("organizationId", GUIDСсылки(Источник.Организация));
	Снимок.Вставить("warehouseId", GUIDСсылки(Источник.Склад));
	Снимок.Вставить("partnerId", GUIDСсылки(Источник.Партнер));
	Снимок.Вставить("counterpartyId", GUIDСсылки(Источник.Контрагент));
	Снимок.Вставить("vehicleId", GUIDСсылки(Источник.Автомобиль));
	Снимок.Вставить("currencyId", GUIDСсылки(Источник.Валюта));
	Снимок.Вставить("priceIncludesVAT", Источник.ЦенаВключаетНДС);
	Строки = Новый Массив;
	Для Каждого Позиция Из Источник.Товары Цикл
		СтрокаСнимка = Новый Структура("lineCode,catalogId,quantity,price,total,vat,totalWithVAT,cancelled",
			Позиция.КодСтроки, GUIDСсылки(Позиция.Номенклатура), Позиция.Количество,
			Позиция.Цена, Позиция.Сумма, Позиция.СуммаНДС, Позиция.СуммаСНДС, Позиция.Отменено);
		СтрокаСнимка.Вставить("warehouseId", GUIDСсылки(Позиция.Склад));
		СтрокаСнимка.Вставить("priceTypeId", GUIDСсылки(Позиция.ВидЦены));
		Строки.Добавить(СтрокаСнимка);
	КонецЦикла;
	Снимок.Вставить("items", Строки);
	Возврат Снимок;
КонецФункции

Процедура ЗафиксироватьИдентичностьСтрок(Снимок, WorkOrderId)
	Запрос = Новый Запрос("ВЫБРАТЬ ItemId, КодСтроки, Номенклатура
		|ИЗ РегистрСведений.AvtoPultСтрокиЗаказов ГДЕ WorkOrderId = &WorkOrderId");
	Запрос.УстановитьПараметр("WorkOrderId", WorkOrderId);
	Связи = Новый Массив;
	Для Каждого Связь Из Запрос.Выполнить().Выгрузить() Цикл
		Связи.Добавить(Новый Структура("lineCode,catalogId,itemId",
			Связь.КодСтроки, GUIDСсылки(Связь.Номенклатура), Связь.ItemId));
	КонецЦикла;
	Коды = Новый Соответствие;
	Для Каждого Позиция Из Снимок.items Цикл
		Количество = Коды.Получить(Позиция.lineCode);
		Коды.Вставить(Позиция.lineCode, ?(Количество = Неопределено, 0, Количество) + 1);
	КонецЦикла;
	Для Каждого Позиция Из Снимок.items Цикл
		Идентичность = ИдентичностьСтроки(Позиция.lineCode, Позиция.catalogId, Связи);
		Если Коды.Получить(Позиция.lineCode) > 1 Тогда
			Идентичность = Новый Структура("itemId,state", "", "conflict");
		КонецЕсли;
		Позиция.Вставить("itemId", Идентичность.itemId);
		Позиция.Вставить("identityState", Идентичность.state);
	КонецЦикла;
	Снимок.schemaVersion = 2;
КонецПроцедуры

// Resolve only the captured mapping, never array position or the newest cloud payload.
Функция ИдентичностьСтроки(КодСтроки, CatalogId, Связи) Экспорт
	Если Не AvtoPultКонтракт.ЦелоеВДиапазоне(КодСтроки, 1, 9007199254740991)
		Или Не AvtoPultКонтракт.GUIDДопустим(CatalogId) Тогда
		Возврат Новый Структура("itemId,state", "", "conflict");
	КонецЕсли;
	Совпадений = 0;
	Найденная = Неопределено;
	Для Каждого Связь Из Связи Цикл
		Если Связь.lineCode = КодСтроки Тогда
			Совпадений = Совпадений + 1;
			Найденная = Связь;
		КонецЕсли;
	КонецЦикла;
	Если Совпадений = 0 Тогда Возврат Новый Структура("itemId,state", "", "unmapped"); КонецЕсли;
	Если Совпадений <> 1 Или Найденная.catalogId <> CatalogId
		Или Не AvtoPultКонтракт.ИдентификаторДопустим(Найденная.itemId) Тогда
		Возврат Новый Структура("itemId,state", "", "conflict");
	КонецЕсли;
	Возврат Новый Структура("itemId,state", Найденная.itemId, "matched");
КонецФункции

Функция GUIDСсылки(Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда Возврат ""; КонецЕсли;
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции
