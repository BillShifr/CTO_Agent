// Server-side installation entry points. No HTTP exposure and no privileged mode.
// Creation does not certify native acceptance or enable document posting.

Функция НастроитьПрофилиИзJSON(JSONНастроек) Экспорт
	ПроверитьВызов("production-profile-setup");
	Если ТипЗнч(JSONНастроек) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(JSONНастроек)) Тогда
		ВызватьИсключение "PROFILE_SETUP_JSON_INVALID";
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(JSONНастроек);
	Параметры = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		ВызватьИсключение "PROFILE_SETUP_JSON_INVALID";
	КонецЕсли;
	ПроверитьМассив(Параметры, "stations");
	ПроверитьМассив(Параметры, "postingProfiles");

	// Resolve and validate every source before the first persistent change.
	Станции = Новый Массив;
	Для Каждого Настройка Из Параметры.stations Цикл
		ПроверитьСтруктуруСтанции(Настройка);
		Источник = НайтиДокумент("ЗаказКлиента", Настройка.orderNumber, Настройка.year);
		Станции.Добавить(Новый Структура("stationId,source,lineNumber",
			Настройка.stationId, Источник, Настройка.lineNumber));
	КонецЦикла;
	Проведение = Новый Массив;
	Для Каждого Настройка Из Параметры.postingProfiles Цикл
		ПроверитьСтруктуруПроведения(Настройка);
		Источник = НайтиДокумент(Настройка.documentType, Настройка.documentNumber, Настройка.year);
		Проведение.Добавить(Новый Структура("profileId,source",
			Настройка.profileId, Источник));
	КонецЦикла;

	РезультатыСтанций = Новый Массив;
	Для Каждого Настройка Из Станции Цикл
		РезультатыСтанций.Добавить(СоздатьПрофильСтанции(
			Настройка.stationId, Настройка.source, Настройка.lineNumber));
	КонецЦикла;
	РезультатыПроведения = Новый Массив;
	Для Каждого Настройка Из Проведение Цикл
		РезультатыПроведения.Добавить(СоздатьПрофильПроведения(
			Настройка.profileId, Настройка.source));
	КонецЦикла;
	Возврат Новый Структура("stationProfiles,postingProfiles",
		РезультатыСтанций, РезультатыПроведения);
КонецФункции

Функция НайтиДокумент(ИмяТипа, НомерДокумента, ГодДокумента) Экспорт
	// Human-readable document number/year replaces manual GUID copying at installation.
	Если ТипЗнч(ИмяТипа) <> Тип("Строка") Или ИменаТипов().Найти(ИмяТипа) = Неопределено Тогда
		ВызватьИсключение "PROFILE_SOURCE_TYPE_INVALID";
	КонецЕсли;
	Если ТипЗнч(НомерДокумента) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(НомерДокумента))
		Или Не AvtoPultКонтракт.ЦелоеВДиапазоне(ГодДокумента, 1900, 9998) Тогда
		ВызватьИсключение "PROFILE_DOCUMENT_SEARCH_INVALID";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка
		|ИЗ Документ." + ИмяТипа + "
		|ГДЕ Номер = &Номер И Дата >= &Начало И Дата < &Конец
		|И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("Номер", СокрЛП(НомерДокумента));
	Запрос.УстановитьПараметр("Начало", Дата(ГодДокумента, 1, 1));
	Запрос.УстановитьПараметр("Конец", Дата(ГодДокумента + 1, 1, 1));
	НайденныеДокументы = Запрос.Выполнить().Выгрузить();
	Если НайденныеДокументы.Количество() <> 1 Тогда
		ВызватьИсключение "PROFILE_DOCUMENT_NOT_UNIQUE_OR_MISSING";
	КонецЕсли;
	Возврат НайденныеДокументы[0].Ссылка;
КонецФункции

Функция СоздатьПрофильСтанции(StationId, ЗаказИсточник, НомерСтроки) Экспорт
	ПроверитьВызов(StationId);
	Если ТипЗнч(ЗаказИсточник) <> Тип("ДокументСсылка.ЗаказКлиента") Тогда
		ВызватьИсключение "PROFILE_SOURCE_TYPE_INVALID";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Заблокировать("РегистрСведений.AvtoPultПрофилиСтанций", "StationId", StationId);
		Заблокировать("Документ.ЗаказКлиента", "Ссылка", ЗаказИсточник);
		Источник = ЗаказИсточник.ПолучитьОбъект();
		Если Источник = Неопределено Или Источник.ПометкаУдаления Тогда
			ВызватьИсключение "PROFILE_SOURCE_UNAVAILABLE";
		КонецЕсли;
		Если Не AvtoPultКонтракт.ЦелоеВДиапазоне(НомерСтроки, 1, Источник.Товары.Количество()) Тогда
			ВызватьИсключение "PROFILE_SOURCE_ROW_INVALID";
		КонецЕсли;
		СтрокаИсточника = Источник.Товары[НомерСтроки - 1];
		ПроверитьНастройки(Источник, СтрокаИсточника);
		Профиль = РегистрыСведений.AvtoPultПрофилиСтанций.СоздатьМенеджерЗаписи();
		Профиль.StationId = StationId;
		Профиль.Прочитать();
		Если Профиль.Выбран() Тогда
			Заблокировать("Документ.ЗаказКлиента", "Ссылка", Профиль.ОбразецЗаказа);
			ПроверитьОбразец(Профиль.ОбразецЗаказа, Источник, СтрокаИсточника);
			Результат = Новый Структура("status,template,verified", "replayed", Профиль.ОбразецЗаказа, Профиль.Проверен);
		Иначе
			Образец = Документы.ЗаказКлиента.СоздатьДокумент();
			Образец.Дата = ТекущаяДатаСеанса();
			ЗаполнитьЗначенияСвойств(Образец, Источник, ПоляШапки());
			СтрокаОбразца = Образец.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбразца, СтрокаИсточника, ПоляСтроки());
			СтрокаОбразца.Склад = Образец.Склад;
			СтрокаОбразца.Количество = 1;
			СтрокаОбразца.КоличествоУпаковок = 1;
			СтрокаОбразца.КодСтроки = 1;
			Образец.МаксимальныйКодСтроки = 1;
			Образец.Комментарий = "Технический образец СТО " + StationId + ". Не проводить.";
			// All monetary values remain zero. Source document and its movements are untouched.
			Образец.Записать(РежимЗаписиДокумента.Запись);
			ПроверитьОбразец(Образец.Ссылка, Источник, СтрокаИсточника);
			Профиль.ОбразецЗаказа = Образец.Ссылка;
			Профиль.Проверен = Ложь;
			Профиль.БезНДСПодтверждено = Ложь;
			Профиль.Записать();
			Результат = Новый Структура("status,template,verified", "created", Образец.Ссылка, Ложь);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
		Возврат Результат;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция СоздатьПрофильПроведения(PostingProfileId, ДокументИсточник) Экспорт
	ПроверитьВызов(PostingProfileId);
	// Validate type before using the reference as a native lock area.
	Если Не ПоддерживаемыйТип(ТипЗнч(ДокументИсточник)) Тогда
		ВызватьИсключение "PROFILE_SOURCE_TYPE_INVALID";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Заблокировать("РегистрСведений.AvtoPultПрофилиПроведения", "PostingProfileId", PostingProfileId);
		Заблокировать("Документ." + ДокументИсточник.Метаданные().Имя, "Ссылка", ДокументИсточник);
		Источник = ДокументИсточник.ПолучитьОбъект();
		Если Источник = Неопределено Или Источник.ПометкаУдаления Или Не Источник.Проведен Тогда
			ВызватьИсключение "PROFILE_POSTED_SOURCE_REQUIRED";
		КонецЕсли;
		Данные = AvtoPultДиагностикаКА2.СформироватьПрофильДвижений(ДокументИсточник);
		РегистрыJSON = AvtoPultКонтракт.JSON(Данные.registers);
		Профиль = РегистрыСведений.AvtoPultПрофилиПроведения.СоздатьМенеджерЗаписи();
		Профиль.PostingProfileId = PostingProfileId;
		Профиль.Прочитать();
		Если Профиль.Выбран() Тогда
			Если Профиль.ТипДокумента <> Данные.documentType Или Профиль.SHA256 <> Данные.sha256
				Или Профиль.РегистрыJSON <> РегистрыJSON Тогда
				ВызватьИсключение "PROFILE_SETTINGS_CONFLICT";
			КонецЕсли;
			Статус = "replayed";
		Иначе
			Профиль.ТипДокумента = Данные.documentType;
			Профиль.РегистрыJSON = РегистрыJSON;
			Профиль.SHA256 = Данные.sha256;
			Профиль.Проверен = Ложь;
			Профиль.Записать();
			Статус = "created";
		КонецЕсли;
		Результат = Новый Структура("status,profileId,verified,sha256", Статус, PostingProfileId, Профиль.Проверен, Профиль.SHA256);
		ЗафиксироватьТранзакцию();
		Возврат Результат;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Процедура ПроверитьВызов(Идентификатор)
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "PROFILE_OUTER_TRANSACTION_FORBIDDEN";
	КонецЕсли;
	Если Не AvtoPultКонтракт.ИдентификаторДопустим(Идентификатор) Тогда
		ВызватьИсключение "PROFILE_ID_INVALID";
	КонецЕсли;
КонецПроцедуры

Функция ПоляШапки()
	Возврат "Организация,Подразделение,Соглашение,Валюта,Склад,ЦенаВключаетНДС,НалогообложениеНДС,ХозяйственнаяОперация,Статус,ПорядокРасчетов,ФормаОплаты,Партнер,Контрагент,Автомобиль";
КонецФункции

Функция ПоляСтроки()
	Возврат "Номенклатура,СтавкаНДС,ВариантОбеспечения,ВидЦены";
КонецФункции

Процедура ПроверитьНастройки(Источник, СтрокаИсточника)
	Для Каждого Имя Из СтрРазделить("Организация,Соглашение,Валюта,Склад", ",") Цикл
		ПроверитьСправочник(Источник[Имя]);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Номенклатура,СтавкаНДС,ВидЦены", ",") Цикл
		ПроверитьСправочник(СтрокаИсточника[Имя]);
	КонецЦикла;
	Если СтрокаИсточника.СуммаНДС <> 0 Или СтрокаИсточника.Отменено Тогда
		ВызватьИсключение "PROFILE_SOURCE_ROW_UNSUPPORTED";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСправочник(Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "PROFILE_REFERENCE_REQUIRED";
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Или Объект.ПометкаУдаления Тогда
		ВызватьИсключение "PROFILE_REFERENCE_UNAVAILABLE";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОбразец(Ссылка, Источник, СтрокаИсточника)
	Образец = Ссылка.ПолучитьОбъект();
	Если Образец = Неопределено Или Образец.ПометкаУдаления Или Образец.Проведен
		Или Образец.Товары.Количество() <> 1 Или Образец.СуммаДокумента <> 0 Тогда
		ВызватьИсключение "PROFILE_TEMPLATE_INVALID";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(ПоляШапки(), ",") Цикл
		Если Образец[Имя] <> Источник[Имя] Тогда ВызватьИсключение "PROFILE_SETTINGS_CONFLICT"; КонецЕсли;
	КонецЦикла;
	СтрокаОбразца = Образец.Товары[0];
	Для Каждого Имя Из СтрРазделить(ПоляСтроки(), ",") Цикл
		Если СтрокаОбразца[Имя] <> СтрокаИсточника[Имя] Тогда ВызватьИсключение "PROFILE_SETTINGS_CONFLICT"; КонецЕсли;
	КонецЦикла;
	Если СтрокаОбразца.СуммаНДС <> 0 Или СтрокаОбразца.Сумма <> 0 Или СтрокаОбразца.СуммаСНДС <> 0
		Или СтрокаОбразца.Цена <> 0 Или СтрокаОбразца.Количество <> 1 Или СтрокаОбразца.КоличествоУпаковок <> 1
		Или СтрокаОбразца.Склад <> Образец.Склад Или СтрокаОбразца.Отменено Тогда
		ВызватьИсключение "PROFILE_TEMPLATE_VALUES_CHANGED";
	КонецЕсли;
	Движения = AvtoPultДиагностикаКА2.НайтиРегистрыДвижений(Ссылка);
	Если Не Движения.Успех Или Движения.Регистры.Количество() <> 0 Тогда
		ВызватьИсключение "PROFILE_TEMPLATE_MOVEMENTS_UNEXPECTED";
	КонецЕсли;
КонецПроцедуры

Процедура Заблокировать(Область, Поле, Значение)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Область);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение(Поле, Значение);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ПоддерживаемыйТип(ТипСсылки)
	Для Каждого Имя Из ИменаТипов() Цикл
		Если ТипСсылки = Тип("ДокументСсылка." + Имя) Тогда Возврат Истина; КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ИменаТипов()
	Возврат СтрРазделить("ЗаказКлиента,СчетНаОплатуКлиенту,ПриходныйКассовыйОрдер,ПоступлениеБезналичныхДенежныхСредств,ОперацияПоПлатежнойКарте,РасходныйКассовыйОрдер,СписаниеБезналичныхДенежныхСредств", ",");
КонецФункции

Процедура ПроверитьМассив(Параметры, Имя)
	Значение = Неопределено;
	Если Не Параметры.Свойство(Имя, Значение) Или ТипЗнч(Значение) <> Тип("Массив") Тогда
		ВызватьИсключение "PROFILE_SETUP_JSON_INVALID";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСтруктуруСтанции(Настройка)
	Если ТипЗнч(Настройка) <> Тип("Структура") Тогда ВызватьИсключение "PROFILE_SETUP_JSON_INVALID"; КонецЕсли;
	Для Каждого Имя Из СтрРазделить("stationId,orderNumber,year,lineNumber", ",") Цикл
		Если Не Настройка.Свойство(Имя) Тогда ВызватьИсключение "PROFILE_SETUP_JSON_INVALID"; КонецЕсли;
	КонецЦикла;
	Если Не AvtoPultКонтракт.ИдентификаторДопустим(Настройка.stationId)
		Или ТипЗнч(Настройка.orderNumber) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(Настройка.orderNumber))
		Или Не AvtoPultКонтракт.ЦелоеВДиапазоне(Настройка.year, 1900, 9998)
		Или Не AvtoPultКонтракт.ЦелоеВДиапазоне(Настройка.lineNumber, 1, 100000) Тогда
		ВызватьИсключение "PROFILE_SETUP_JSON_INVALID";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСтруктуруПроведения(Настройка)
	Если ТипЗнч(Настройка) <> Тип("Структура") Тогда ВызватьИсключение "PROFILE_SETUP_JSON_INVALID"; КонецЕсли;
	Для Каждого Имя Из СтрРазделить("profileId,documentType,documentNumber,year", ",") Цикл
		Если Не Настройка.Свойство(Имя) Тогда ВызватьИсключение "PROFILE_SETUP_JSON_INVALID"; КонецЕсли;
	КонецЦикла;
	Если Не AvtoPultКонтракт.ИдентификаторДопустим(Настройка.profileId)
		Или ТипЗнч(Настройка.documentType) <> Тип("Строка")
		Или ИменаТипов().Найти(Настройка.documentType) = Неопределено
		Или ТипЗнч(Настройка.documentNumber) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(Настройка.documentNumber))
		Или Не AvtoPultКонтракт.ЦелоеВДиапазоне(Настройка.year, 1900, 9998) Тогда
		ВызватьИсключение "PROFILE_SETUP_JSON_INVALID";
	КонецЕсли;
КонецПроцедуры
