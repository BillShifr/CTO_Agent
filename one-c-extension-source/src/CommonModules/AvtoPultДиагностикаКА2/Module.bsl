// Read-only discovery for the customer's test infobase.
// It does not infer a posting profile: every inaccessible register is returned as an error.

Функция НайтиРегистрыДвижений(Ссылка) Экспорт
	ИмяТипаДокумента = ПроверитьТипДокумента(Ссылка);
	Регистры = Новый Массив;
	Ошибки = Новый Массив;
	Для Каждого Регистр Из Метаданные.РегистрыНакопления Цикл
		Если Регистр.СтандартныеРеквизиты.Найти("Регистратор") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если ЕстьДвижение(Ссылка, Регистр.Имя) Тогда
				Регистры.Добавить(Регистр.Имя);
			КонецЕсли;
		Исключение
			Ошибки.Добавить(Новый Структура("Регистр,Код", Регистр.Имя, "MOVEMENT_REGISTER_READ_FAILED"));
		КонецПопытки;
	КонецЦикла;
	Возврат Новый Структура("ТипДокумента,Регистры,Ошибки,Успех",
		ИмяТипаДокумента, Регистры, Ошибки, Ошибки.Количество() = 0);
КонецФункции

Функция СформироватьПрофильДвижений(Ссылка) Экспорт
	Диагностика = НайтиРегистрыДвижений(Ссылка);
	Если Не Диагностика.Успех Тогда
		ВызватьИсключение "MOVEMENT_PROFILE_SCAN_FAILED";
	КонецЕсли;
	Если Диагностика.Регистры.Количество() = 0 Тогда
		ВызватьИсключение "MOVEMENT_PROFILE_EMPTY";
	КонецЕсли;
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя");
	Для Каждого ИмяРегистра Из Диагностика.Регистры Цикл
		СтрокаРегистра = Таблица.Добавить();
		СтрокаРегистра.Имя = ИмяРегистра;
	КонецЦикла;
	Таблица.Сортировать("Имя Возр");
	Регистры = Новый Массив;
	Для Каждого СтрокаРегистра Из Таблица Цикл
		Регистры.Добавить(СтрокаРегистра.Имя);
	КонецЦикла;
	Профиль = Новый Структура("documentType,registers", Диагностика.ТипДокумента, Регистры);
	JSON = AvtoPultКонтракт.JSON(Профиль);
	Профиль.Вставить("sha256", AvtoPultИнтеграция.SHA256(JSON));
	Возврат Профиль;
КонецФункции

Функция ЕстьДвижение(Ссылка, ИмяРегистра)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		| ИСТИНА КАК ЕстьДвижение
		|ИЗ РегистрНакопления." + ИмяРегистра + " КАК Движения
		|ГДЕ Движения.Регистратор = &Регистратор");
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция ПроверитьТипДокумента(Ссылка)
	ТипСсылки = ТипЗнч(Ссылка);
	Если ТипСсылки = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Возврат "Document_ЗаказКлиента";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетНаОплатуКлиенту") Тогда
		Возврат "Document_СчетНаОплатуКлиенту";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		Возврат "Document_ПриходныйКассовыйОрдер";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Тогда
		Возврат "Document_ПоступлениеБезналичныхДенежныхСредств";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ОперацияПоПлатежнойКарте") Тогда
		Возврат "Document_ОперацияПоПлатежнойКарте";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		Возврат "Document_РасходныйКассовыйОрдер";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") Тогда
		Возврат "Document_СписаниеБезналичныхДенежныхСредств";
	КонецЕсли;
	ВызватьИсключение "MOVEMENT_DOCUMENT_TYPE_UNSUPPORTED";
КонецФункции
